<Window x:Class="TheOrder.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Order · 原生候选 Phase 3A">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <InfoBar x:Name="NoticeBar" IsClosable="False" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}" AutomationProperties.AutomationId="TransactionNotice"/>
  <InfoBar Grid.Row="1" Title="当前书架为只读" Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" Message="{x:Bind ViewModel.CapabilityMessage, Mode=OneWay}" AutomationProperties.AutomationId="ReadOnlyNotice"/>
  <NavigationView x:Name="Navigation" Grid.Row="2" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Visible" IsSettingsVisible="False" SelectionChanged="OnNavigationChanged" BackRequested="OnBack">
   <NavigationView.MenuItems><NavigationViewItem x:Name="LibraryNavigation" Content="书架" Tag="library" Icon="Library" AutomationProperties.AutomationId="LibraryNavigation"/><NavigationViewItem x:Name="SettingsNavigation" Content="设置" Tag="settings" Icon="Setting" AutomationProperties.AutomationId="SettingsNavigation"/></NavigationView.MenuItems>
   <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </NavigationView>
 </Grid>
</Window>
