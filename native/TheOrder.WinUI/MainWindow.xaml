<Window x:Class="TheOrder.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Order · 原生候选 Phase 5B.2">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <InfoBar x:Name="NoticeBar" IsClosable="False" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}" AutomationProperties.AutomationId="TransactionNotice"/>
  <InfoBar Grid.Row="1" Title="当前书架为只读" Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" Message="{x:Bind ViewModel.CapabilityMessage, Mode=OneWay}" AutomationProperties.AutomationId="ReadOnlyNotice"/>
  <Border Grid.Row="2" Padding="16,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"><StackPanel Spacing="4">
   <InfoBar x:Name="LifecycleNotice" Severity="Warning" IsClosable="False" IsOpen="False" AutomationProperties.AutomationId="LifecycleNotice"/>
   <TextBlock x:Name="SessionTitle" Text="当前没有游玩会话" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionTitle"/>
   <TextBlock x:Name="SessionState" Text="正在恢复上次会话…" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionState"/>
   <TextBlock x:Name="SessionDuration" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionDuration"/>
   <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="PauseTiming" Content="暂停计时" IsEnabled="False" Click="OnPauseTiming" AutomationProperties.AutomationId="PauseTiming"/><Button x:Name="ResumeTiming" Content="恢复计时" IsEnabled="False" Click="OnResumeTiming" AutomationProperties.AutomationId="ResumeTiming"/><Button Content="退出 The Order" Click="OnExitApp" AutomationProperties.AutomationId="ExitTheOrder"/></StackPanel>
  </StackPanel></Border>
  <NavigationView x:Name="Navigation" Grid.Row="3" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Visible" IsSettingsVisible="False" ItemInvoked="OnNavigationInvoked" BackRequested="OnBack">
  <NavigationView.MenuItems><NavigationViewItem x:Name="LibraryNavigation" Content="书架" Tag="library" Icon="Library" AutomationProperties.AutomationId="LibraryNavigation"/><NavigationViewItem x:Name="OnlineNavigation" Content="发现作品" Tag="online" Icon="World" AutomationProperties.AutomationId="OnlineNavigation"/><NavigationViewItem x:Name="RecognitionNavigation" Content="识别与核对" Tag="recognition" Icon="Find" AutomationProperties.AutomationId="RecognitionNavigation"/><NavigationViewItem x:Name="SettingsNavigation" Content="设置" Tag="settings" Icon="Setting" AutomationProperties.AutomationId="SettingsNavigation"/></NavigationView.MenuItems>
   <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </NavigationView>
  <StackPanel x:Name="DiagnosticsPanel" Grid.Row="4" Visibility="Collapsed">
   <StackPanel x:Name="RecognitionBoundaryControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><Button Content="延迟候选 200" Click="OnDelayCandidate"/><Button Content="候选放行" Click="OnReleaseCandidate"/><Button Content="模拟凭据变化" Click="OnSyntheticAuthChange"/></StackPanel>
   <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="合成验收控制"/><Button Content="延迟详情" Click="OnDelayDetails"/><Button Content="刷新故障" Click="OnFailRefresh"/><Button Content="延迟批量" Click="OnDelayBatch"/><Button Content="重读故障" Click="OnFailReload"/><Button Content="放行" Click="OnRelease"/><Button Content="取消操作" Click="OnCancelOperation"/><Button Content="延迟搜索" Click="OnDelayQuery"/><Button Content="延迟扫描" Click="OnDelayScan"/></StackPanel>
   <TextBlock x:Name="RuntimeState" TextTrimming="CharacterEllipsis" MaxHeight="18" FontSize="10" AutomationProperties.AutomationId="RuntimeEvidence"/>
  </StackPanel>
 </Grid>
</Window>
