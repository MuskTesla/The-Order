<Window x:Class="TheOrder.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Order · 原生候选 Phase 1">
  <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <InfoBar Grid.Row="0" x:Name="GlobalError" Title="无法读取资料" Severity="Error" IsClosable="False" IsOpen="{x:Bind Errors.IsOpen, Mode=OneWay}" Message="{x:Bind Errors.Message, Mode=OneWay}" AutomationProperties.AutomationId="GlobalError" />
    <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Collapsed" IsSettingsVisible="False" SelectionChanged="OnNavigationChanged">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="LibraryNavigation" Content="书架" Tag="library" Icon="Library" AutomationProperties.AutomationId="LibraryNavigation" />
        <NavigationViewItem Content="设置" Tag="settings" Icon="Setting" AutomationProperties.AutomationId="SettingsNavigation" />
      </NavigationView.MenuItems>
      <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </NavigationView>
  </Grid>
</Window>
