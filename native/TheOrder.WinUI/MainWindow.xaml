<Window x:Class="TheOrder.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Order">
 <Grid x:Name="Root" Background="{ThemeResource CanvasBrush}" SizeChanged="OnShellSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="12,8,12,0"><InfoBar x:Name="NoticeBar" IsClosable="True" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}" AutomationProperties.AutomationId="TransactionNotice"/><InfoBar Title="当前书架为只读" Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" Message="{x:Bind ViewModel.CapabilityMessage, Mode=OneWay}" AutomationProperties.AutomationId="ReadOnlyNotice"/></StackPanel>
  <Border x:Name="NavigationSurface" Grid.Row="1" Margin="0" BorderThickness="0" Background="Transparent">
   <NavigationView x:Name="Navigation" PaneDisplayMode="Auto" OpenPaneLength="196" CompactPaneLength="48" ExpandedModeThresholdWidth="1040" CompactModeThresholdWidth="720" IsBackButtonVisible="Visible" IsSettingsVisible="False" ItemInvoked="OnNavigationInvoked" BackRequested="OnBack" DisplayModeChanged="OnNavigationDisplayModeChanged">
    <NavigationView.Resources><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/><SolidColorBrush x:Key="NavigationViewDefaultPaneBackground" Color="Transparent"/><StaticResource x:Key="NavigationViewSelectionIndicatorForeground" ResourceKey="AccentBrush"/></NavigationView.Resources>
    <NavigationView.PaneHeader><StackPanel Orientation="Horizontal" Spacing="10" Padding="14,14,8,18"><Border Width="30" Height="30" Padding="2" CornerRadius="6" Background="{ThemeResource BrandBadgeBrush}"><Image Source="Assets/Brand.png" Width="26" Height="26"/></Border><TextBlock Text="The Order" FontSize="17" FontWeight="SemiBold" Foreground="{ThemeResource TextPrimaryBrush}" VerticalAlignment="Center"/></StackPanel></NavigationView.PaneHeader>
    <NavigationView.MenuItems><NavigationViewItem x:Name="LibraryNavigation" Content="书架" Tag="library" Icon="Library" AutomationProperties.AutomationId="LibraryNavigation"/><NavigationViewItem x:Name="OnlineNavigation" Content="发现作品" Tag="online" Icon="World" AutomationProperties.AutomationId="OnlineNavigation"/><NavigationViewItem x:Name="RecognitionNavigation" Content="识别与核对" Tag="recognition" Icon="Find" AutomationProperties.AutomationId="RecognitionNavigation"/></NavigationView.MenuItems>
    <NavigationView.FooterMenuItems><NavigationViewItem x:Name="SettingsNavigation" Content="设置" Tag="settings" Icon="Setting" AutomationProperties.AutomationId="SettingsNavigation"/></NavigationView.FooterMenuItems>
    <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
   </NavigationView>
  </Border>
  <Border x:Name="SessionSurface" Grid.Row="2" Background="{ThemeResource ContentBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0,1,0,0" Padding="24,10">
   <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <FontIcon x:Name="SessionIcon" Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource TextSecondaryBrush}" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Spacing="2"><InfoBar x:Name="LifecycleNotice" Severity="Warning" IsClosable="False" IsOpen="False" AutomationProperties.AutomationId="LifecycleNotice"/><TextBlock x:Name="SessionTitle" Text="当前没有游玩会话" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionTitle"/><TextBlock x:Name="SessionState" Text="正在恢复上次会话…" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="SessionState"/><TextBlock x:Name="SessionDuration" FontFamily="Cascadia Mono" FontSize="12" Width="240" HorizontalAlignment="Left" TextWrapping="NoWrap" AutomationProperties.AutomationId="SessionDuration"/><TextBlock x:Name="SessionHistory" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionHistory"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="PauseTiming" Content="暂停计时" IsEnabled="False" Click="OnPauseTiming" AutomationProperties.AutomationId="PauseTiming"/><Button x:Name="ResumeTiming" Content="恢复计时" IsEnabled="False" Click="OnResumeTiming" AutomationProperties.AutomationId="ResumeTiming"/><Button Content="退出 The Order" Click="OnExitApp" AutomationProperties.AutomationId="ExitTheOrder"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel x:Name="DiagnosticsPanel" Grid.Row="3" Visibility="Collapsed">
   <StackPanel x:Name="RecognitionBoundaryControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><Button Content="延迟候选 200" Click="OnDelayCandidate"/><Button Content="候选放行" Click="OnReleaseCandidate"/><Button Content="模拟凭据变化" Click="OnSyntheticAuthChange"/></StackPanel>
   <StackPanel x:Name="SyntheticControls" Orientation="Horizontal" Spacing="8"><TextBlock Text="合成验收控制"/><Button Content="延迟详情" Click="OnDelayDetails"/><Button Content="刷新故障" Click="OnFailRefresh"/><Button Content="延迟批量" Click="OnDelayBatch"/><Button Content="重读故障" Click="OnFailReload"/><Button Content="放行" Click="OnRelease"/><Button Content="取消操作" Click="OnCancelOperation"/><Button Content="延迟搜索" Click="OnDelayQuery"/><Button Content="延迟扫描" Click="OnDelayScan"/></StackPanel>
   <TextBlock x:Name="RuntimeState" TextTrimming="CharacterEllipsis" MaxHeight="18" FontSize="10" AutomationProperties.AutomationId="RuntimeEvidence"/>
  </StackPanel>
 </Grid>
</Window>
