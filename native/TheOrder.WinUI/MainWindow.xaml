<Window x:Class="TheOrder.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Order · 原生候选 Phase 4A.1">
 <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <InfoBar x:Name="NoticeBar" IsClosable="False" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}" AutomationProperties.AutomationId="TransactionNotice"/>
  <InfoBar Grid.Row="1" Title="当前书架为只读" Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" Message="{x:Bind ViewModel.CapabilityMessage, Mode=OneWay}" AutomationProperties.AutomationId="ReadOnlyNotice"/>
  <NavigationView x:Name="Navigation" Grid.Row="2" PaneDisplayMode="LeftCompact" IsBackButtonVisible="Visible" IsSettingsVisible="False" ItemInvoked="OnNavigationInvoked" BackRequested="OnBack">
   <NavigationView.MenuItems><NavigationViewItem x:Name="LibraryNavigation" Content="书架" Tag="library" Icon="Library" AutomationProperties.AutomationId="LibraryNavigation"/><NavigationViewItem x:Name="OnlineNavigation" Content="发现作品" Tag="online" Icon="World" AutomationProperties.AutomationId="OnlineNavigation"/><NavigationViewItem x:Name="SettingsNavigation" Content="设置" Tag="settings" Icon="Setting" AutomationProperties.AutomationId="SettingsNavigation"/></NavigationView.MenuItems>
   <ContentControl x:Name="PageContent" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
  </NavigationView>
  <StackPanel x:Name="DiagnosticsPanel" Grid.Row="3" Visibility="Collapsed">
   <StackPanel Orientation="Horizontal" Spacing="8"><TextBlock Text="合成验收控制"/><Button Content="延迟详情" Click="OnDelayDetails"/><Button Content="刷新故障" Click="OnFailRefresh"/><Button Content="延迟批量" Click="OnDelayBatch"/><Button Content="重读故障" Click="OnFailReload"/><Button Content="放行" Click="OnRelease"/><Button Content="取消操作" Click="OnCancelOperation"/><Button Content="延迟搜索" Click="OnDelayQuery"/><Button Content="延迟扫描" Click="OnDelayScan"/></StackPanel>
   <TextBlock x:Name="RuntimeState" TextTrimming="CharacterEllipsis" MaxHeight="18" FontSize="10" AutomationProperties.AutomationId="RuntimeEvidence"/>
  </StackPanel>
 </Grid>
</Window>
