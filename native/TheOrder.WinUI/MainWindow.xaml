<?xml version="1.0" encoding="utf-8"?><Window x:Class="TheOrder.WinUI.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="The Order" xmlns:l="using:TheOrder.WinUI.Localization">
 <Grid x:Name="Root" SizeChanged="OnShellSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <!-- Solid canvas replaces Mica when transparency is off (system, app setting, HC or policy fault). -->
  <Border x:Name="OpaqueCanvas" Grid.RowSpan="3" Background="{ThemeResource CanvasBrush}" />
  <!-- Fluent title bar: brand, library search and the session indicator. Back lives below the brand only when available. × keeps
       The Order in the tray and the tray menu exits. -->
  <TitleBar x:Name="AppTitleBar" Title="The Order" IsBackButtonVisible="False" IsBackButtonEnabled="False" IsPaneToggleButtonVisible="False" BackRequested="OnTitleBack" PaneToggleRequested="OnPaneToggle" AutomationProperties.AutomationId="AppTitleBar">
   <TitleBar.IconSource><ImageIconSource ImageSource="ms-appx:///Assets/Brand.Light.png" /></TitleBar.IconSource>
   <TitleBar.RightHeader>
    <Button x:Name="SessionSurface" Visibility="Collapsed" Style="{StaticResource SubtleButtonStyle}" Padding="8,4,10,4" Margin="0,0,4,0" CornerRadius="16" AutomationProperties.AutomationId="SessionIndicator">
     <StackPanel Orientation="Horizontal" Spacing="8">
      <FontIcon x:Name="SessionIcon" Glyph="" FontSize="14" VerticalAlignment="Center" />
      <TextBlock x:Name="SessionChipTitle" MaxWidth="180" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
      <TextBlock x:Name="SessionDuration" FontFamily="Cascadia Mono" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" AutomationProperties.AutomationId="SessionDuration" />
     </StackPanel>
     <Button.Flyout>
      <Flyout Placement="BottomEdgeAlignedRight">
       <StackPanel Width="320" Spacing="8">
        <TextBlock x:Name="SessionTitle" Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionTitle" l:Localize.Text="当前没有游玩会话" />
        <TextBlock x:Name="SessionState" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="SessionState" l:Localize.Text="正在恢复上次会话…" />
        <TextBlock x:Name="SessionFlyoutDuration" FontFamily="Cascadia Mono" FontSize="14" AutomationProperties.AutomationId="SessionFlyoutDuration" />
        <TextBlock x:Name="SessionHistory" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="SessionHistory" />
        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
         <Button x:Name="PauseTiming" IsEnabled="False" Click="OnPauseTiming" AutomationProperties.AutomationId="PauseTiming" l:Localize.Content="暂停计时" />
         <Button x:Name="ResumeTiming" IsEnabled="False" Click="OnResumeTiming" AutomationProperties.AutomationId="ResumeTiming" l:Localize.Content="恢复计时" />
         <Button x:Name="SessionDetails" Click="OnSessionDetails" AutomationProperties.AutomationId="SessionDetails" l:Localize.Content="打开详情" />
        </StackPanel>
        <TextBlock Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" l:Localize.Text="关闭窗口后 The Order 留在系统托盘并继续计时；从托盘图标菜单可完全退出。" />
       </StackPanel>
      </Flyout>
     </Button.Flyout>
    </Button>
   </TitleBar.RightHeader>
  </TitleBar>
  <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsPaneOpen="True" OpenPaneLength="96" CompactPaneLength="96" IsBackButtonVisible="Collapsed" IsPaneToggleButtonVisible="False" IsSettingsVisible="False" IsTitleBarAutoPaddingEnabled="False" ItemInvoked="OnNavigationInvoked" DisplayModeChanged="OnNavigationDisplayModeChanged">
   <NavigationView.Resources>
    <ResourceDictionary>
     <!-- This leaf-only rail has no expansion chevrons. Balance the presenter's built-in 14 DIP right inset
          so centered icon/label content receives equal 8 DIP gutters and localized labels are not clipped. -->
     <Thickness x:Key="NavigationViewItemContentPresenterMargin">8,0,-6,0</Thickness>
     <ResourceDictionary.ThemeDictionaries>
      <!-- The built-in ContentGrid otherwise paints a second gray slab over Mica. -->
      <ResourceDictionary x:Key="Light"><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" /></ResourceDictionary>
      <ResourceDictionary x:Key="Default"><SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" /></ResourceDictionary>
      <ResourceDictionary x:Key="HighContrast"><SolidColorBrush x:Key="NavigationViewContentBackground" Color="{ThemeResource SystemColorWindowColor}" /></ResourceDictionary>
     </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
   </NavigationView.Resources>
   <NavigationView.PaneHeader><Button x:Name="RailBack" Width="60" Height="36" HorizontalAlignment="Center" Visibility="Collapsed" Click="OnRailBack" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="GoBack" l:Localize.Name="返回书架"><FontIcon Glyph="" FontSize="18" /></Button></NavigationView.PaneHeader>
   <NavigationView.MenuItems>
    <NavigationViewItem x:Name="LibraryNavigation" Tag="library" HorizontalContentAlignment="Center" Padding="0" Height="74" AutomationProperties.AutomationId="LibraryNavigation" l:Localize.Name="书架"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="" FontSize="23" HorizontalAlignment="Center" /><TextBlock FontSize="12" HorizontalAlignment="Center" l:Localize.Text="书架" /></StackPanel></NavigationViewItem>
    <NavigationViewItem x:Name="OnlineNavigation" Tag="online" HorizontalContentAlignment="Center" Padding="0" Height="74" AutomationProperties.AutomationId="OnlineNavigation" l:Localize.Name="发现"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="" FontSize="23" HorizontalAlignment="Center" /><TextBlock FontSize="12" HorizontalAlignment="Center" l:Localize.Text="发现" /></StackPanel></NavigationViewItem>
   </NavigationView.MenuItems>
   <NavigationView.FooterMenuItems>
    <NavigationViewItem x:Name="SettingsNavigation" Tag="settings" HorizontalContentAlignment="Center" Padding="0" Height="74" AutomationProperties.AutomationId="SettingsNavigation" l:Localize.Name="设置"><StackPanel Spacing="6" HorizontalAlignment="Center"><Grid Width="34" Height="28"><FontIcon Glyph="" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse x:Name="UpdateBadge" Width="6" Height="6" Fill="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" /></Grid><TextBlock FontSize="12" HorizontalAlignment="Center" l:Localize.Text="设置" /></StackPanel></NavigationViewItem>
   </NavigationView.FooterMenuItems>
   <!-- Transparent page content shares the shell backdrop; high contrast keeps its system surface. -->
   <Grid x:Name="ContentLayer" Background="{ThemeResource LayerBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="0">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel x:Name="NoticeStack" Spacing="8" Margin="24,8,24,0">
     <InfoBar x:Name="NoticeBar" IsClosable="True" IsOpen="{x:Bind ViewModel.HasNotice, Mode=OneWay}" Message="{x:Bind ViewModel.Notice.Message, Mode=OneWay}" AutomationProperties.AutomationId="TransactionNotice" />
     <InfoBar Severity="Warning" IsClosable="False" IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}" Message="{x:Bind ViewModel.CapabilityMessage, Mode=OneWay}" AutomationProperties.AutomationId="ReadOnlyNotice" l:Localize.Title="当前书架为只读" />
     <InfoBar x:Name="LifecycleNotice" Severity="Warning" IsClosable="False" IsOpen="False" AutomationProperties.AutomationId="LifecycleNotice" />
     <InfoBar x:Name="LaunchNotice" IsClosable="True" IsOpen="False" AutomationProperties.AutomationId="QuickLaunchNotice" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <ContentControl x:Name="PageContent" Grid.Row="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" />
   </Grid>
  </NavigationView>
  <!-- Test diagnostics only. Receipts keep reading RuntimeState; Ctrl+Shift+D toggles visibility in diagnostics builds. -->
  <StackPanel x:Name="DiagnosticsPanel" Grid.Row="2" Visibility="Collapsed">
   <StackPanel x:Name="RecognitionBoundaryControls" Orientation="Horizontal" Spacing="8" Visibility="Collapsed"><Button Click="OnDelayCandidate" l:Localize.Content="延迟候选 200" /><Button Click="OnReleaseCandidate" l:Localize.Content="候选放行" /><Button Click="OnSyntheticAuthChange" l:Localize.Content="模拟凭据变化" /></StackPanel>
   <StackPanel x:Name="SyntheticControls" Orientation="Horizontal" Spacing="8"><TextBlock l:Localize.Text="合成验收控制" /><Button Click="OnDelayDetails" l:Localize.Content="延迟详情" /><Button Click="OnFailRefresh" l:Localize.Content="刷新故障" /><Button Click="OnDelayBatch" l:Localize.Content="延迟批量" /><Button Click="OnFailReload" l:Localize.Content="重读故障" /><Button Click="OnRelease" l:Localize.Content="放行" /><Button Click="OnCancelOperation" l:Localize.Content="取消操作" /><Button Click="OnDelayQuery" l:Localize.Content="延迟搜索" /><Button Click="OnDelayScan" l:Localize.Content="延迟扫描" /></StackPanel>
   <TextBlock x:Name="RuntimeState" TextTrimming="CharacterEllipsis" MaxHeight="18" FontSize="10" AutomationProperties.AutomationId="RuntimeEvidence" />
  </StackPanel>
 </Grid>
</Window>
