<UserControl
 x:Class="TheOrder.WinUI.Materials.RefractionGallery"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled">
  <StackPanel Padding="28,24" Spacing="20" MaxWidth="1100" HorizontalAlignment="Stretch">
   <StackPanel Spacing="6">
    <TextBlock Text="材质实验室" Style="{StaticResource PageTitleStyle}"/>
    <TextBlock Text="安静中心 · 圆润边缘 · 背景驱动色散" Style="{StaticResource SectionTitleStyle}"/>
    <TextBlock Text="同场景比较原材质与两种曲面采样候选。前景独立；高级材质仅限 Test。" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/>
   </StackPanel>
   <Border Style="{StaticResource SurfaceStyle}" Padding="0" CornerRadius="20">
    <Grid x:Name="Stage" Height="280" SizeChanged="OnStageSizeChanged">
     <Grid x:Name="PatternSource" Background="#FFE8EDF0">
      <Grid x:Name="PatternCapture" Width="1300" Height="660" HorizontalAlignment="Left" VerticalAlignment="Top"><Grid.Clip><RectangleGeometry Rect="0,0,1300,660"/></Grid.Clip>
       <Canvas x:Name="PatternLayer" Width="1300" Height="660" HorizontalAlignment="Left" VerticalAlignment="Top"/>
      </Grid>
     </Grid>
     <SwapChainPanel x:Name="OpticalPanel" IsHitTestVisible="False" Visibility="Collapsed"/>
     <Border x:Name="LensFrame" Width="320" Height="180" CornerRadius="24" PointerEntered="OnLensHover" PointerExited="OnLensExit" PointerPressed="OnLensPress" PointerReleased="OnLensRelease" BorderThickness="1" BorderBrush="{ThemeResource StrokeBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Grid>
       <Grid x:Name="LensHost" IsHitTestVisible="False"/>
       <Border x:Name="StableForeground" Background="#18FFFFFF" CornerRadius="23" Padding="24">
        <Border x:Name="StableTextPanel" CornerRadius="12" Padding="12,8" VerticalAlignment="Center">
        <StackPanel VerticalAlignment="Center" Spacing="8">
         <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon x:Name="StableIcon" Width="18" Height="18" Data="F0 M 2,1 H 14 V 17 H 2 Z M 4,3 V 15 H 12 V 3 Z M 5,5 H 11 V 6 H 5 Z M 5,8 H 11 V 9 H 5 Z M 5,11 H 9 V 12 H 5 Z" Foreground="#FF183A45" AutomationProperties.AccessibilityView="Raw"/>
          <TextBlock x:Name="StableTitle" Text="文字保持稳定" FontSize="18" FontWeight="SemiBold" Foreground="#FF183A45"/>
         </StackPanel>
         <TextBlock x:Name="StableBody" Text="The Order · 内容优先" FontSize="14" Foreground="#FF294852"/>
         <TextBlock x:Name="StableCaption" Text="安静中心 · 透明圆角边缘" FontSize="12" Foreground="#FF35515B" TextWrapping="Wrap"/>
        </StackPanel>
        </Border>
       </Border>
       <Border x:Name="LensHighlight" CornerRadius="23" BorderThickness="1" IsHitTestVisible="False" Opacity="0.45"><Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0.7,1"><GradientStop Offset="0" Color="#CCFFFFFF"/><GradientStop Offset="0.35" Color="#20FFFFFF"/><GradientStop Offset="0.7" Color="#08FFFFFF"/><GradientStop Offset="1" Color="#30202629"/></LinearGradientBrush></Border.BorderBrush></Border>
      </Grid>
     </Border>
    </Grid>
   </Border>
   <Border Style="{StaticResource ToolbarSurfaceStyle}">
    <StackPanel Spacing="14">
     <StackPanel x:Name="ReviewModes" Orientation="Horizontal" Spacing="12">
      <ComboBox x:Name="ComparisonMode" Header="同场景对照" SelectedIndex="2" SelectionChanged="OnReviewChanged" AutomationProperties.AutomationId="GalleryComparison" MinWidth="190"><ComboBoxItem Content="A · 稳定材质"/><ComboBoxItem Content="B · 仅折射"/><ComboBoxItem Content="Baseline · 原色散"/><ComboBoxItem Content="候选 1 · 圆润厚玻璃"/><ComboBoxItem Content="候选 2 · 日常玻璃"/></ComboBox>
      <ComboBox x:Name="BackgroundMode" Header="背景来源" SelectedIndex="0" SelectionChanged="OnBackgroundChanged" AutomationProperties.AutomationId="GalleryBackground" MinWidth="190"><ComboBoxItem Content="黑白文字与线条"/><ComboBoxItem Content="细网格"/><ComboBoxItem Content="实际 Test 封面图片"/><ComboBoxItem Content="平滑浅色"/><ComboBoxItem Content="平滑深色"/><ComboBoxItem Content="用户参考图 · 封面区域"/><ComboBoxItem Content="ATRI · 明亮封面"/><ComboBoxItem Content="徒花异谭 · 深色封面"/><ComboBoxItem Content="作品氛围 · 合成封面"/><ComboBoxItem Content="作品氛围 · 参考图"/></ComboBox>
      <ToggleSwitch x:Name="DispersionSwitch" Header="候选色散" IsOn="True" Toggled="OnDispersionChanged" AutomationProperties.AutomationId="GalleryDispersion"/><ComboBox x:Name="BodyMode" Header="玻璃主体 · Test" SelectedIndex="0" SelectionChanged="OnBodyModeChanged" MinWidth="190" AutomationProperties.AutomationId="GalleryBody" AutomationProperties.Name="玻璃主体材质"><ComboBoxItem Content="C1 · 清透（原始）"/><ComboBoxItem Content="修订 1 · 清透边缘 + 磨砂中心"/><ComboBoxItem Content="修订 2 · 连续玻璃"/><ComboBoxItem Content="修订 3 · 完全清透"/></ComboBox><Button Content="推荐参数" Click="OnRecommended" VerticalAlignment="Bottom" AutomationProperties.AutomationId="GalleryRecommended"/>
     </StackPanel>
     <StackPanel x:Name="ControlActions" Orientation="Horizontal" Spacing="12">
      <ToggleSwitch x:Name="AdvancedSwitch" Header="高级材质 · Test" IsOn="False" Toggled="OnAdvancedToggled" AutomationProperties.Name="启用实时内部背景折射原型"/>
      <Button Content="演示一次背景移动" Click="OnMovePattern" AutomationProperties.AutomationId="GalleryMovePattern"/>
      <Button Content="恢复起点" Click="OnResetPattern" AutomationProperties.AutomationId="GalleryResetPattern"/>
     </StackPanel>
     <Grid x:Name="SlidersLayout" ColumnSpacing="16" RowSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel Spacing="4"><TextBlock Text="背景位置" Style="{StaticResource SecondaryTextStyle}"/><Slider x:Name="PatternSlider" Minimum="0" Maximum="100" Value="0" ValueChanged="OnPatternChanged" AutomationProperties.Name="背景位置"/></StackPanel>
      <StackPanel x:Name="LensSliderPanel" Grid.Column="1" Spacing="4"><TextBlock Text="透镜位置" Style="{StaticResource SecondaryTextStyle}"/><Slider x:Name="LensSlider" Minimum="-100" Maximum="100" Value="0" ValueChanged="OnLensChanged" AutomationProperties.Name="透镜位置"/></StackPanel>
      <StackPanel x:Name="StrengthSliderPanel" Grid.Column="2" Spacing="4"><TextBlock Text="折射强度" Style="{StaticResource SecondaryTextStyle}"/><Slider x:Name="StrengthSlider" Minimum="0" Maximum="1.5" Value="1" ValueChanged="OnStrengthChanged" AutomationProperties.Name="折射强度"/></StackPanel>
      <StackPanel x:Name="DispersionSliderPanel" Grid.Row="1" Spacing="4"><TextBlock Text="色散 · 推荐 0.75／诊断 2" Style="{StaticResource SecondaryTextStyle}"/><Slider x:Name="DispersionSlider" Minimum="0" Maximum="2" Value="0.75" ValueChanged="OnStrengthChanged" AutomationProperties.Name="色散强度"/></StackPanel>
      <StackPanel x:Name="EdgeSliderPanel" Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="边缘宽度（DIP）" Style="{StaticResource SecondaryTextStyle}"/><Slider x:Name="EdgeSlider" Minimum="8" Maximum="22" Value="18" ValueChanged="OnStrengthChanged" AutomationProperties.Name="边缘影响宽度"/></StackPanel>
      <StackPanel x:Name="HighlightSliderPanel" Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Text="独立中性高光" Style="{StaticResource SecondaryTextStyle}"/><Slider x:Name="HighlightSlider" Minimum="0" Maximum="1" Value="0.45" ValueChanged="OnStrengthChanged" AutomationProperties.Name="高光强度"/></StackPanel>
     </Grid>
    </StackPanel>
   </Border>
   <TextBlock x:Name="MaterialState" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="GalleryMaterialState"/>
   <TextBlock Text="候选使用本页原分辨率背景和有限移动，具体来源见材质状态；不代表书架实时采样。公开 Direct3D 曲面近似，不是 Apple 私有算法。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
  </StackPanel>
 </ScrollViewer>
</UserControl>
