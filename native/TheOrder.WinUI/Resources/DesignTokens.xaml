 </ResourceDictionary.ThemeDictionaries>
 <x:Double x:Key="SpaceSmall">8</x:Double><x:Double x:Key="SpaceMedium">16</x:Double><x:Double x:Key="SpaceLarge">24</x:Double><x:Double x:Key="SectionSpacing">24</x:Double>
 <Thickness x:Key="PagePadding">28,20,28,20</Thickness><CornerRadius x:Key="CardRadius">8</CornerRadius><CornerRadius x:Key="FloatingRadius">12</CornerRadius>
 <x:Double x:Key="MotionPageMilliseconds">140</x:Double><x:Double x:Key="MotionShortMilliseconds">100</x:Double><x:Double x:Key="FocusStrokeWidth">2</x:Double>
 <Style x:Key="PageTitleStyle" TargetType="TextBlock"><Setter Property="FontFamily" Value="Segoe UI Variable"/><Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="WorkTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitleStyle}"><Setter Property="FontSize" Value="28"/></Style>
 <Style x:Key="SectionTitleStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/></Style>
 <Style x:Key="BodyTextStyle" TargetType="TextBlock"><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="FontSize" Value="13"/><Setter Property="Foreground" Value="{ThemeResource TextSecondaryBrush}"/></Style>
 <Style x:Key="MetadataTextStyle" TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}"><Setter Property="FontSize" Value="12"/></Style>
 <Style x:Key="CardTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
 <Style x:Key="SurfaceStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource ContentBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/></Style>
 <Style x:Key="ToolbarSurfaceStyle" TargetType="Border"><Setter Property="Background" Value="{ThemeResource ToolbarBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource StrokeBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/></Style>
 <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}"><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="6"/></Style>
 <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}"><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="6"/></Style>
 <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"><Setter Property="MinHeight" Value="36"/><Setter Property="FontSize" Value="14"/><Setter Property="CornerRadius" Value="6"/></Style>
 <Style TargetType="ContentDialog" BasedOn="{StaticResource DefaultContentDialogStyle}"><Setter Property="CornerRadius" Value="16"/><Setter Property="TitleTemplate"><Setter.Value><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SectionTitleStyle}"/></DataTemplate></Setter.Value></Setter></Style>
</ResourceDictionary>
