<Page x:Class="TheOrder.WinUI.Views.RecognitionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:TheOrder.Presentation" xmlns:local="using:TheOrder.WinUI.Views">
 <Grid Padding="{StaticResource PagePadding}" RowSpacing="10">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="识别与核对" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="高分是建议。作品、版本和本地来源一致后，再确认关联。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/></StackPanel>
  <VariableSizedWrapGrid Grid.Row="1" Orientation="Horizontal" ItemWidth="180" ItemHeight="62" MaximumRowsOrColumns="6">
   <Button Content="只补缺失资料" Click="OnMissing" AutomationProperties.AutomationId="RecognizeMissing"/>
   <Button Content="取消本轮识别" Click="OnCancel" AutomationProperties.AutomationId="RecognitionCancel"/>
   <ToggleSwitch Header="在线补充" IsOn="{x:Bind ViewModel.UseOnline, Mode=TwoWay}" OnContent="启用" OffContent="仅本地" AutomationProperties.AutomationId="RecognitionOnline"/>
   <ToggleSwitch Header="程序版本线索（可选）" IsOn="{x:Bind ViewModel.IncludePe, Mode=TwoWay}" OnContent="读取有界资源" OffContent="只用文件名" AutomationProperties.AutomationId="RecognitionPe"/>
  </VariableSizedWrapGrid>
  <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionProgress"/><TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionMessage"/><TextBlock Text="{x:Bind ViewModel.PersistenceError, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"/></StackPanel>
  <Grid Grid.Row="3" ColumnSpacing="18"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListView x:Name="ReviewList" ItemsSource="{x:Bind ViewModel.Reviews, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedReviewItem, Mode=OneWay}" SelectionMode="Single" SelectionChanged="OnReview" AutomationProperties.AutomationId="RecognitionReviews">
    <ListView.ItemTemplate><DataTemplate x:DataType="p:RecognitionReviewCard"><StackPanel Padding="6" Spacing="6"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind Status}" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/><TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" MaxLines="3" Style="{StaticResource SecondaryTextStyle}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
   </ListView>
   <ScrollViewer x:Name="ReviewDetails" Grid.Column="1"><StackPanel Spacing="10">
    <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap"/>
    <TextBlock Text="{x:Bind ViewModel.SelectedMessage, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionSelectedState"/>
    <TextBlock Text="{x:Bind ViewModel.LocalFacts, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RecognitionLocalFacts"/>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="重新识别" Click="OnRerun" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRerun"/><Button Content="忽略本次建议" Click="OnIgnore" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionIgnore"/><Button Content="打开本地详情" Click="OnLocalDetails" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/></StackPanel>
    <ListView ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCandidateItem, Mode=OneWay}" SelectionMode="Single" SelectionChanged="OnCandidate" AutomationProperties.AutomationId="RecognitionCandidates">
     <ListView.ItemTemplate><DataTemplate x:DataType="p:RecognitionCandidateCard"><StackPanel Padding="6" Spacing="5"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{ThemeResource BodyStrongTextBlockStyle}"/><TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Evidence}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Text="{x:Bind Conflicts}" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}"/><Button Content="查看候选详情" Tag="{x:Bind Id}" Click="OnRemoteDetails"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
    <Button Content="确认应用所选候选" Click="OnApply" IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RecognitionApply"/>
    <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="手动关联 · 目录作品编号" Text="{x:Bind ViewModel.ManualId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="先核对目标作品与版本" MaxLength="20" AutomationProperties.AutomationId="RecognitionManualId"/><Button Grid.Column="1" Content="确认手动关联" VerticalAlignment="Bottom" Click="OnManual" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionManualApply"/></Grid>
    <local:CoverPresenter SourceKey="{x:Bind ViewModel.RemoteCoverKey, Mode=OneWay}" Width="140" Height="190" HorizontalAlignment="Left"/>
    <TextBlock Text="{x:Bind ViewModel.RemoteFacts, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RecognitionRemoteFacts"/>
   </StackPanel></ScrollViewer>
  </Grid>
 </Grid>
</Page>
