<Page x:Class="TheOrder.WinUI.Views.RecognitionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:TheOrder.Presentation" xmlns:local="using:TheOrder.WinUI.Views">
 <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <VisualStateManager.VisualStateGroups><VisualStateGroup>
   <VisualState x:Name="ReviewWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100"/></VisualState.StateTriggers></VisualState>
   <VisualState x:Name="ReviewNarrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters>
    <Setter Target="ReviewSurface.(Grid.ColumnSpan)" Value="2"/><Setter Target="ReviewDetailSurface.(Grid.Row)" Value="1"/><Setter Target="ReviewDetailSurface.(Grid.Column)" Value="0"/><Setter Target="ReviewDetailSurface.(Grid.ColumnSpan)" Value="2"/>
    <Setter Target="ReviewListRow.Height" Value="2*"/><Setter Target="ReviewDetailRow.Height" Value="3*"/><Setter Target="ReviewLayout.RowSpacing" Value="16"/>
    <Setter Target="IgnoreReviewButton.(Grid.Row)" Value="1"/><Setter Target="IgnoreReviewButton.(Grid.Column)" Value="0"/><Setter Target="OpenLocalDetailButton.(Grid.Row)" Value="2"/><Setter Target="OpenLocalDetailButton.(Grid.Column)" Value="0"/><Setter Target="ReviewActions.RowSpacing" Value="8"/>
    <Setter Target="ManualApplyButton.(Grid.Row)" Value="1"/><Setter Target="ManualApplyButton.(Grid.Column)" Value="0"/><Setter Target="ManualApplyButton.(Grid.ColumnSpan)" Value="2"/><Setter Target="ManualIdBox.(Grid.ColumnSpan)" Value="2"/><Setter Target="ManualActions.RowSpacing" Value="8"/>
   </VisualState.Setters></VisualState>
  </VisualStateGroup></VisualStateManager.VisualStateGroups>
  <StackPanel Spacing="8"><TextBlock Text="识别与核对" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="导入后自动识别：排序分严格大于 0.9、身份与版本一致且唯一领先时自动应用；歧义或证据不足的结果在此选择。排序分不是正确概率。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource ToolbarSurfaceStyle}" Padding="16">
   <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="68" MaximumRowsOrColumns="6">
    <Button Content="只补缺失资料" Click="OnMissing" AutomationProperties.AutomationId="RecognizeMissing"/>
    <Button Content="取消本轮识别" Click="OnCancel" AutomationProperties.AutomationId="RecognitionCancel"/>
    <ToggleSwitch Header="在线补充" IsOn="{x:Bind ViewModel.UseOnline, Mode=TwoWay}" OnContent="启用" OffContent="仅本地" AutomationProperties.AutomationId="RecognitionOnline" AutomationProperties.Name="识别时使用在线补充"/>
    <ToggleSwitch Header="程序版本线索（可选）" IsOn="{x:Bind ViewModel.IncludePe, Mode=TwoWay}" OnContent="读取有界资源" OffContent="只用文件名" AutomationProperties.AutomationId="RecognitionPe" AutomationProperties.Name="识别时读取程序版本线索" ToolTipService.ToolTip="默认启用，与旧版一致。只读程序版本资源，不运行游戏；可关闭，读取也可能触发系统安全扫描。"/>
   </VariableSizedWrapGrid>
  </Border>
  <StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionProgress"/><TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionMessage" AutomationProperties.LiveSetting="Polite"/><TextBlock Text="{x:Bind ViewModel.PersistenceError, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Foreground="{ThemeResource WarningTextBrush}" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Grid x:Name="ReviewLayout" Grid.Row="3" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="ReviewListRow" Height="*"/><RowDefinition x:Name="ReviewDetailRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="ReviewSurface" Style="{StaticResource SurfaceStyle}" Padding="12">
    <ListView x:Name="ReviewList" ItemsSource="{x:Bind ViewModel.Reviews, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedReviewItem, Mode=OneWay}" SelectionMode="Single" SelectionChanged="OnReview" AutomationProperties.AutomationId="RecognitionReviews" AutomationProperties.Name="需要核对的作品关联">
     <ListView.ItemTemplate><DataTemplate x:DataType="p:RecognitionReviewCard"><StackPanel Padding="8" Spacing="8"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{x:Bind Status}" Style="{StaticResource BodyTextStyle}"/><TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" MaxLines="3" Style="{StaticResource SecondaryTextStyle}"/></StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Border>
   <Border x:Name="ReviewDetailSurface" Grid.Column="1" Style="{StaticResource SurfaceStyle}" Padding="20">
    <ScrollViewer x:Name="ReviewDetails" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
     <TextBlock Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" Style="{StaticResource SectionTitleStyle}" TextWrapping="Wrap"/>
     <TextBlock Text="{x:Bind ViewModel.SelectedMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionSelectedState" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock Text="{x:Bind ViewModel.LocalFacts, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RecognitionLocalFacts"/>
     <Grid x:Name="ReviewActions" ColumnSpacing="8" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Button Content="重新识别" Click="OnRerun" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRerun"/><Button x:Name="IgnoreReviewButton" Grid.Column="1" Content="忽略本次建议" Click="OnIgnore" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionIgnore"/><Button x:Name="OpenLocalDetailButton" Grid.Column="2" Content="打开本地详情" Click="OnLocalDetails" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"/>
     </Grid>
     <ListView ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCandidateItem, Mode=OneWay}" SelectionMode="Single" SelectionChanged="OnCandidate" AutomationProperties.AutomationId="RecognitionCandidates" AutomationProperties.Name="待核对的目录作品候选">
      <ListView.ItemTemplate><DataTemplate x:DataType="p:RecognitionCandidateCard"><StackPanel Padding="12" Spacing="8"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Evidence}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Text="{x:Bind Conflicts}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Foreground="{ThemeResource WarningTextBrush}"/><Button Content="查看候选详情" Tag="{x:Bind Id}" Click="OnRemoteDetails"/></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Button Content="确认应用所选候选" Click="OnApply" IsEnabled="{x:Bind ViewModel.CanApply, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RecognitionApply"/>
     <Grid x:Name="ManualActions" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBox x:Name="ManualIdBox" Header="手动关联 · 目录作品编号" Text="{x:Bind ViewModel.ManualId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="先核对目标作品与版本" MaxLength="20" AutomationProperties.AutomationId="RecognitionManualId" AutomationProperties.Name="手动关联的目录作品编号"/><Button x:Name="ManualApplyButton" Grid.Column="1" Content="确认手动关联" VerticalAlignment="Bottom" Click="OnManual" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionManualApply"/>
     </Grid>
     <local:CoverPresenter SourceKey="{x:Bind ViewModel.RemoteCoverKey, Mode=OneWay}" Width="140" Height="190" HorizontalAlignment="Left"/>
     <TextBlock Text="{x:Bind ViewModel.RemoteFacts, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RecognitionRemoteFacts"/>
     <ItemsControl ItemsSource="{x:Bind ViewModel.RemoteLinks, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRemoteLinks">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="p:CandidateDetailLink"><StackPanel Spacing="4"><HyperlinkButton Content="{x:Bind Title}" Tag="{x:Bind Url}" Click="OnOpenLink" HorizontalAlignment="Left"/><TextBlock Text="{x:Bind Url}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Page>
