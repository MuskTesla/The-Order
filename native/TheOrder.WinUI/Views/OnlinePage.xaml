<?xml version="1.0" encoding="utf-8"?><Page x:Class="TheOrder.WinUI.Views.OnlinePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:TheOrder.Presentation" xmlns:local="using:TheOrder.WinUI.Views" xmlns:l="using:TheOrder.WinUI.Localization">
 <Page.Resources><Style x:Key="OnlineCardStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}"><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style></Page.Resources>
 <Grid Padding="24,16,24,24">
  <Grid x:Name="SearchResults" RowSpacing="16">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
   <StackPanel x:Name="SearchHeader" Spacing="20" HorizontalAlignment="Stretch">
   <StackPanel x:Name="DiscoveryHeading" Spacing="10"><TextBlock x:Name="DiscoveryTitle" Style="{StaticResource PageTitleStyle}" l:Localize.Text="发现作品" /><TextBlock x:Name="DiscoveryHint" Text="从熟悉的名字开始，寻找下一段故事。" FontSize="16" Opacity=".65" TextAlignment="Center" TextWrapping="Wrap" /></StackPanel>
   <Grid x:Name="SearchBar" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <TextBox x:Name="OnlineQueryBox" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="OnQueryKeyDown" AutomationProperties.AutomationId="OnlineQuery" l:Localize.PlaceholderText="搜索作品名或别名" l:Localize.Name="搜索在线作品目录，回车搜索" />
    <Button Grid.Column="1" Click="OnSearch" AutomationProperties.AutomationId="OnlineSearch" l:Localize.Content="搜索" />
    <Button x:Name="CancelSearchButton" Grid.Column="2" Click="OnCancel" IsEnabled="{x:Bind ViewModel.SearchBusy, Mode=OneWay}" AutomationProperties.AutomationId="OnlineCancel" l:Localize.Content="取消" />
   </Grid>
   <StackPanel x:Name="ProviderAttribution" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"><Image Source="ms-appx:///Assets/KunGal.png" Width="28" Height="28" AutomationProperties.Name="KunGal" /><StackPanel Spacing="2"><TextBlock Text="搜索基于 KunGal Galgame 目录" FontSize="13" /><TextBlock Text="由 NextMoe 提供搜索服务" FontSize="12" Opacity=".6" /></StackPanel></StackPanel>
   <StackPanel Spacing="8"><ProgressBar IsIndeterminate="True" Visibility="{x:Bind BusyVisibility(ViewModel.SearchBusy), Mode=OneWay}" l:Localize.Name="正在搜索作品" /><TextBlock x:Name="SearchStatus" Text="{x:Bind ViewModel.SearchMessage, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource MetadataTextStyle}" AutomationProperties.AutomationId="OnlineSearchMessage" AutomationProperties.LiveSetting="Polite" /></StackPanel>
   </StackPanel>
   <GridView x:Name="ResultsGrid" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnWork" ItemContainerStyle="{StaticResource OnlineCardStyle}" SizeChanged="OnResultsSizeChanged" AutomationProperties.AutomationId="OnlineResults" l:Localize.Name="作品封面网格">
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" Loaded="OnWrapLoaded" /></ItemsPanelTemplate></GridView.ItemsPanel>
    <GridView.ItemTemplate><DataTemplate x:DataType="p:OnlineCard"><Grid Margin="8,8,8,16" RowSpacing="9" AutomationProperties.Name="{x:Bind Title}"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions><Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><local:CoverPresenter SourceKey="{x:Bind CoverKey}" /></Border><TextBlock Grid.Row="1" Text="{x:Bind Title}" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="15" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title}" /></Grid></DataTemplate></GridView.ItemTemplate>
   </GridView>
   <Button x:Name="LoadMoreButton" Grid.Row="2" Click="OnMore" IsEnabled="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" HorizontalAlignment="Left" AutomationProperties.AutomationId="OnlineMore" l:Localize.Content="加载下一页" />
  </Grid>
  <ContentControl x:Name="BrowserHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
 </Grid>
</Page>
