<Page x:Class="TheOrder.WinUI.Views.OnlinePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:TheOrder.Presentation" xmlns:local="using:TheOrder.WinUI.Views">
 <Grid Padding="{StaticResource PagePadding}" RowSpacing="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <VisualStateManager.VisualStateGroups><VisualStateGroup>
   <VisualState x:Name="OnlineWide"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="1100"/></VisualState.StateTriggers></VisualState>
   <VisualState x:Name="OnlineNarrow"><VisualState.StateTriggers><AdaptiveTrigger MinWindowWidth="0"/></VisualState.StateTriggers><VisualState.Setters>
    <Setter Target="OnlineQueryBox.(Grid.ColumnSpan)" Value="2"/><Setter Target="SearchActions.(Grid.Row)" Value="1"/><Setter Target="SearchActions.(Grid.Column)" Value="0"/><Setter Target="SearchActions.(Grid.ColumnSpan)" Value="2"/><Setter Target="SearchControls.RowSpacing" Value="8"/>
    <Setter Target="ResultsSurface.(Grid.ColumnSpan)" Value="2"/><Setter Target="DetailSurface.(Grid.Row)" Value="1"/><Setter Target="DetailSurface.(Grid.Column)" Value="0"/><Setter Target="DetailSurface.(Grid.ColumnSpan)" Value="2"/>
    <Setter Target="ResultsRow.Height" Value="2*"/><Setter Target="DetailRow.Height" Value="3*"/><Setter Target="ResultsLayout.RowSpacing" Value="16"/>
    <Setter Target="RefreshOnlineDetailButton.(Grid.Row)" Value="1"/><Setter Target="RefreshOnlineDetailButton.(Grid.Column)" Value="0"/><Setter Target="OnlineDetailActions.RowSpacing" Value="8"/>
   </VisualState.Setters></VisualState>
  </VisualStateGroup></VisualStateManager.VisualStateGroups>
  <TextBlock Text="发现作品" Style="{StaticResource PageTitleStyle}"/>
  <Border Grid.Row="1" Style="{StaticResource ToolbarSurfaceStyle}" Padding="16">
   <Grid x:Name="SearchControls" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBox x:Name="OnlineQueryBox" PlaceholderText="搜索在线目录 · 中文名、日文名或别名" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="OnlineQuery" AutomationProperties.Name="搜索在线作品目录"/>
    <StackPanel x:Name="SearchActions" Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="搜索 / 重试" Click="OnSearch" AutomationProperties.AutomationId="OnlineSearch"/><Button Content="取消" Click="OnCancel" AutomationProperties.AutomationId="OnlineCancel"/></StackPanel>
   </Grid>
  </Border>
  <StackPanel Grid.Row="2" Spacing="8"><ProgressBar IsIndeterminate="True" Visibility="{x:Bind BusyVisibility(ViewModel.SearchBusy), Mode=OneWay}" AutomationProperties.Name="正在搜索在线作品"/><TextBlock Text="{x:Bind ViewModel.SearchMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="OnlineSearchMessage" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Grid x:Name="ResultsLayout" Grid.Row="3" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition x:Name="ResultsRow" Height="*"/><RowDefinition x:Name="DetailRow" Height="0"/></Grid.RowDefinitions>
   <Border x:Name="ResultsSurface" Style="{StaticResource SurfaceStyle}" Padding="16">
    <Grid RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ListView ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" IsItemClickEnabled="True" ItemClick="OnWork" SelectionMode="None" AutomationProperties.AutomationId="OnlineResults" AutomationProperties.Name="在线作品搜索结果">
      <ListView.ItemTemplate><DataTemplate x:DataType="p:OnlineCard"><Grid Padding="8" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><local:CoverPresenter SourceKey="{x:Bind CoverKey}" Width="60" Height="84"/><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource CardTitleStyle}"/><TextBlock Text="{x:Bind Subtitle}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}"/></StackPanel></Grid></DataTemplate></ListView.ItemTemplate>
     </ListView><Button Grid.Row="1" Content="加载下一页" Click="OnMore" IsEnabled="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}" AutomationProperties.AutomationId="OnlineMore"/>
    </Grid>
   </Border>
   <Border x:Name="DetailSurface" Grid.Column="1" Style="{StaticResource SurfaceStyle}" Padding="20">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="16">
     <TextBlock Text="{x:Bind ViewModel.DetailTitle, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SectionTitleStyle}"/>
     <TextBlock Text="{x:Bind ViewModel.DetailMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="OnlineDetailMessage" AutomationProperties.LiveSetting="Polite"/>
     <ProgressBar IsIndeterminate="True" Visibility="{x:Bind BusyVisibility(ViewModel.DetailBusy), Mode=OneWay}" AutomationProperties.Name="正在读取作品详情"/>
     <local:CoverPresenter SourceKey="{x:Bind ViewModel.DetailCoverKey, Mode=OneWay}" Width="160" Height="220" HorizontalAlignment="Left"/>
     <Grid x:Name="OnlineDetailActions" ColumnSpacing="8" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Button Content="加入愿望单" Click="OnAdd" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="OnlineAddWishlist"/><Button x:Name="RefreshOnlineDetailButton" Grid.Column="1" Content="刷新 / 重试详情" Click="OnRefresh" AutomationProperties.AutomationId="OnlineRefreshDetails"/>
     </Grid>
     <TextBlock Text="{x:Bind ViewModel.DetailFacts, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
     <TextBlock Text="{x:Bind ViewModel.DetailDescription, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
 </Grid>
</Page>
