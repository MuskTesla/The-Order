<?xml version="1.0" encoding="utf-8"?><Page x:Class="TheOrder.WinUI.Views.DetailsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:TheOrder.WinUI.Views" xmlns:l="using:TheOrder.WinUI.Localization">
 <Grid>
 <Grid x:Name="DetailsRoot" SizeChanged="OnDetailsSizeChanged">
  <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <ScrollViewer x:Name="DetailsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
    <StackPanel x:Name="DetailsColumn" Spacing="16" MaxWidth="1360" HorizontalAlignment="Stretch" Padding="32,12,32,24">
    <BreadcrumbBar x:Name="Breadcrumb" ItemClicked="OnBreadcrumb" AutomationProperties.AutomationId="DetailsBreadcrumb" />
    <views:TagFlowPanel x:Name="HeroActions" HorizontalAlignment="Right" HorizontalSpacing="8" VerticalSpacing="8">
         <Button x:Name="ConfirmLaunchButton" Width="108" Height="36" Padding="8,0" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind ActionVisible(Launch.PositionChanged), Mode=OneWay}" Click="OnConfirmPosition" IsEnabled="{x:Bind Launch.CanConfirm, Mode=OneWay}" AutomationProperties.AutomationId="ConfirmLaunchPosition" l:Localize.Content="确认启动位置" />
         <Button x:Name="LaunchGameButton" Width="108" Height="36" Padding="8,0" Click="OnLaunch" IsEnabled="{x:Bind Launch.CanActivate, Mode=OneWay}" Visibility="{x:Bind HasInstallations(Launch.Installations.Length), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="LaunchGame" l:Localize.Name="启动游戏">
          <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock l:Localize.Text="启动游戏" /></StackPanel>
         </Button>
         <Button x:Name="AddInstallationButton" Width="108" Height="36" Padding="8,0" Style="{StaticResource AccentButtonStyle}" Visibility="{x:Bind NoInstallations(Launch.Installations.Length), Mode=OneWay}" Click="OnInstallations" AutomationProperties.AutomationId="AddLocalInstallation" l:Localize.Content="管理本地安装" l:Localize.ToolTip="添加或管理本地安装" />
         <Button x:Name="CancelLaunchButton" Width="108" Height="36" Padding="8,0" Visibility="{x:Bind ActionVisible(Launch.CanCancel), Mode=OneWay}" Click="OnCancelLaunch" IsEnabled="{x:Bind Launch.CanCancel, Mode=OneWay}" AutomationProperties.AutomationId="CancelLaunch" l:Localize.Content="取消启动" />
          <Button x:Name="EditDetailsButton" Width="80" Height="36" Padding="8,0" Click="OnEdit" AutomationProperties.AutomationId="EditGame" l:Localize.Name="编辑个人记录"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock l:Localize.Text="编辑" /></StackPanel></Button>
          <Button x:Name="HeroMore" Width="40" Height="36" Padding="8,0" AutomationProperties.AutomationId="DetailsMore" l:Localize.Name="更多作品操作"><FontIcon Glyph="" FontSize="14" />
          <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedLeft" Opening="OnLaunchMenuOpening">
           <MenuFlyoutItem Click="OnInstallations" l:Localize.Text="安装与启动设置"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
           <MenuFlyoutSubItem x:Name="LaunchInstallationsMenu" l:Localize.Text="选择本次安装" />
           <MenuFlyoutItem x:Name="CoverButton" Click="OnCover" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ChooseLocalCover" l:Localize.Text="选择本地封面"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
           <MenuFlyoutItem Click="OnWorkCover" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ChooseWorkCover" l:Localize.Text="选择作品封面…" />
           <MenuFlyoutItem Click="OnDefaultCover" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RestoreDefaultCover" l:Localize.Text="恢复自动推荐封面" />
           <MenuFlyoutItem Click="OnBanner" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ChooseLocalBanner" l:Localize.Text="选择本地横幅…"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
           <MenuFlyoutItem Click="OnDefaultBanner" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RestoreDefaultBanner" l:Localize.Text="恢复自动横幅" />
           <MenuFlyoutItem x:Name="RecognizeButton" Click="OnRecognize" AutomationProperties.AutomationId="RecognizeOne" l:Localize.Text="重新识别"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
           <MenuFlyoutSeparator />
           <MenuFlyoutItem Click="OnRefreshOnline" l:Localize.Text="刷新在线资料"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
           <MenuFlyoutItem x:Name="RemoveWishlistButton" Click="OnRemoveWishlist" l:Localize.Text="移除愿望条目"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem>
          </MenuFlyout></Button.Flyout>
         </Button>
        </views:TagFlowPanel>
     <!-- Preserve the scene's aspect and keep information over it whenever it fits. -->
    <Grid x:Name="HeroFrame" Opacity="0" IsHitTestVisible="False" SizeChanged="OnHeroSizeChanged">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
     <views:ArtworkStage x:Name="HeroStage" Height="160" AutomationProperties.AutomationId="DetailsHero" />
     <Grid x:Name="HeroLayout" Padding="28" Canvas.ZIndex="10">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border x:Name="HeroPlate" Grid.RowSpan="2" MaxWidth="620" HorizontalAlignment="Left" VerticalAlignment="Bottom" Padding="24,18,24,18" CornerRadius="23">
       <StackPanel Spacing="6">
         <TextBlock x:Name="HeroTitle" Text="{x:Bind ViewModel.Draft.Source.Personal.Name, Mode=OneWay}" Style="{StaticResource WorkTitleStyle}" TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="DetailTitle" AutomationProperties.HeadingLevel="Level1" />
        <views:CatalogFactsView x:Name="HeroFacts" />
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
         <TextBlock x:Name="HeroStatusText" Text="{x:Bind StatusLabel(ViewModel.Draft.Status), Mode=OneWay}" Opacity=".86" Foreground="{ThemeResource TextSecondaryBrush}" Style="{StaticResource BodyTextStyle}" AutomationProperties.AutomationId="DetailPersonalStatus" />
         <TextBlock x:Name="HeroRatingText" Text="{x:Bind RatingLabel(ViewModel.Draft.Source.Personal.Rating), Mode=OneWay}" Opacity=".86" Style="{StaticResource BodyTextStyle}" />
         <FontIcon Glyph="" FontSize="14" Foreground="{ThemeResource AccentBrush}" Visibility="{x:Bind ActionVisible(ViewModel.Draft.Favorite), Mode=OneWay}" l:Localize.Name="收藏" />
        </StackPanel>
        <views:TagFlowPanel HorizontalSpacing="20" VerticalSpacing="4" MaximumItemWidth="1000" Margin="0,4,0,0">
         <TextBlock x:Name="HeroPlayText" Text="{x:Bind ViewModel.Draft.Source.Playtime, Mode=OneWay}" TextWrapping="Wrap" FontSize="13" AutomationProperties.AutomationId="HeroPlaySummary" />
         <TextBlock x:Name="LastPlayedText" FontSize="13" Opacity=".85" TextWrapping="Wrap" />
        </views:TagFlowPanel>
        <TextBlock x:Name="PersonalLabelsText" FontSize="12" Opacity=".85" TextWrapping="Wrap" />
       </StackPanel>
      </Border>
     </Grid>
    </Grid>
    <TextBlock Text="{x:Bind Launch.Message, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="LaunchMessage" AutomationProperties.LiveSetting="Polite" />
<Grid x:Name="BodyGrid" ColumnSpacing="32" RowSpacing="24" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <StackPanel x:Name="ReadOnlyDetails" Spacing="22">
        <TextBlock x:Name="CatalogReadStatus" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
        <Button x:Name="RetryCatalog" HorizontalAlignment="Left" Visibility="Collapsed" Click="OnRetryCatalog" l:Localize.Content="重试资料" />
        <views:CatalogContentView x:Name="RichCatalog">       <Expander x:Name="SourcesInfo" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" l:Localize.Header="资料与图片来源"><StackPanel Spacing="8"><TextBlock x:Name="ArtworkSourceText" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" /><ItemsControl x:Name="SourceLinks"><ItemsControl.ItemTemplate><DataTemplate x:DataType="views:DetailSourceLink"><HyperlinkButton Content="{x:Bind Title}" Tag="{x:Bind Url}" Click="OnSourceLink" HorizontalAlignment="Left" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander></views:CatalogContentView>
        <StackPanel x:Name="NotesSection" Spacing="10"><TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="我的笔记" /><views:MarkdownView x:Name="PersonalNotesText" /></StackPanel>
       </StackPanel>

            <Border x:Name="EditorCard" Background="Transparent" Padding="0,8" Visibility="Collapsed" VerticalAlignment="Top">
      <StackPanel Spacing="16">
       <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel Spacing="2"><TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="个人记录" /><TextBlock Style="{StaticResource MetadataTextStyle}" l:Localize.Text="名称、状态、评分、收藏、分类与笔记" /></StackPanel>
        <StackPanel Grid.Column="1" Spacing="8"><Button Click="OnFinishEditing" l:Localize.Content="返回详情" l:Localize.Name="结束编辑并返回详情" /><TextBlock x:Name="DraftStatus" Text="{x:Bind DirtyText(ViewModel.IsDirty), Mode=OneWay}" VerticalAlignment="Center" Style="{StaticResource MetadataTextStyle}" AutomationProperties.AutomationId="DraftState" AutomationProperties.LiveSetting="Polite" /></StackPanel>
       </Grid>
       <ContentControl IsEnabled="{x:Bind ViewModel.CanEditDetails, Mode=OneWay}" HorizontalContentAlignment="Stretch">
        <StackPanel x:Name="Editor" Spacing="16">
         <TextBox x:Name="NameEditor" Text="{x:Bind ViewModel.Draft.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="2000" AutomationProperties.AutomationId="EditName" l:Localize.Header="个人名称" l:Localize.Name="个人名称" />
         <Grid x:Name="PersonalFields" ColumnSpacing="16" RowSpacing="16">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <ComboBox x:Name="StatusEditor" HorizontalAlignment="Stretch" SelectedValuePath="Tag" SelectedValue="{x:Bind ViewModel.Draft.Status, Mode=TwoWay}" AutomationProperties.AutomationId="EditStatus" l:Localize.Header="游玩状态" l:Localize.Name="作品的个人游玩状态"><ComboBoxItem Tag="planned" l:Localize.Content="未开始" /><ComboBoxItem Tag="playing" l:Localize.Content="在玩" /><ComboBoxItem Tag="completed" l:Localize.Content="已完成" /><ComboBoxItem Tag="paused" l:Localize.Content="搁置" /><ComboBoxItem Tag="dropped" l:Localize.Content="放弃" /></ComboBox>
          <TextBox x:Name="RatingEditor" Grid.Column="1" Text="{x:Bind ViewModel.Draft.Rating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditRating" l:Localize.Header="个人评分 · 0–10，可留空" l:Localize.Name="个人评分，0到10，可留空" />
          <ToggleSwitch x:Name="FavoriteEditor" Grid.Column="2" IsOn="{x:Bind ViewModel.Draft.Favorite, Mode=TwoWay}" AutomationProperties.AutomationId="EditFavorite" l:Localize.Header="收藏" l:Localize.OnContent="已收藏" l:Localize.OffContent="未收藏" />
         </Grid>
         <TextBox Text="{x:Bind ViewModel.Draft.Categories, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditCategories" l:Localize.Header="分类 · 逗号、中文逗号或换行分隔" l:Localize.Name="个人分类" />
         <TextBox Text="{x:Bind ViewModel.Draft.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditTags" l:Localize.Header="个人标签" l:Localize.Name="个人标签" />
         <TextBox MinHeight="150" MaxHeight="320" AcceptsReturn="True" TextWrapping="Wrap" Text="{x:Bind ViewModel.Draft.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EditNotes" l:Localize.Header="笔记" l:Localize.Name="个人笔记" />
        </StackPanel>
       </ContentControl>
      </StackPanel>
     </Border>
      <Border x:Name="ReviewSection" Grid.Row="2" Visibility="Collapsed" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,24,0,0"><ContentControl x:Name="ReviewHost" HorizontalContentAlignment="Stretch" IsTabStop="False" /></Border>
     </Grid>
    </StackPanel>
   </ScrollViewer>
   <!-- Save bar: present only while the draft has unsaved changes; all leave guards are unchanged. -->
  <Border x:Name="SaveBar" Grid.Row="1" Visibility="{x:Bind ActionVisible(ViewModel.IsDirty), Mode=OneWay}" Margin="16,0,16,16" Padding="16,10" CornerRadius="8" Background="{ThemeResource ToolbarBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1">
   <Grid x:Name="SaveFooter" ColumnSpacing="16">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
    <Ellipse Width="8" Height="8" Fill="{ThemeResource WarningTextBrush}" VerticalAlignment="Center" />
    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource BodyTextStyle}" l:Localize.Text="有尚未保存的修改" />
    <StackPanel x:Name="SaveActions" Grid.Column="2" Orientation="Horizontal" Spacing="8">
     <Button Click="OnCancel" IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}" AutomationProperties.AutomationId="CancelEdit" l:Localize.Content="取消修改" />
     <Button Style="{StaticResource AccentButtonStyle}" Click="OnSave" IsEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}" AutomationProperties.AutomationId="SaveEdit" l:Localize.Content="保存修改" />
    </StackPanel>
   </Grid>
  </Border>
 </Grid>
 <ContentControl x:Name="CatalogHost" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Padding="24,12,24,24" MaxWidth="1160" />
 </Grid>
</Page>
