<?xml version="1.0" encoding="utf-8"?><Page x:Class="TheOrder.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:TheOrder.WinUI.Localization">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel Padding="{StaticResource PagePadding}" Spacing="32" MaxWidth="840" HorizontalAlignment="Stretch">
   <TextBlock Style="{StaticResource PageTitleStyle}" l:Localize.Text="设置" />
   <StackPanel Spacing="16">
    <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="外观与浏览" />
    <StackPanel x:Name="LanguageOptions" Spacing="8" Visibility="Collapsed">
     <ComboBox x:Name="LanguageChoice" MaxWidth="360" HorizontalAlignment="Stretch" SelectionChanged="OnLanguage" AutomationProperties.AutomationId="LanguageChoice" l:Localize.Header="语言" l:Localize.Name="界面与资料语言"><ComboBoxItem l:Localize.Content="跟随系统" /><ComboBoxItem l:Localize.Content="简体中文" /><ComboBoxItem l:Localize.Content="繁體中文" /><ComboBoxItem l:Localize.Content="日本語" /><ComboBoxItem Content="English" /></ComboBox>
     <TextBlock Text="{x:Bind Languages.Message, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="LanguageState" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
    <ComboBox x:Name="ThemeChoice" MaxWidth="360" HorizontalAlignment="Stretch" SelectionChanged="OnAppearance" AutomationProperties.AutomationId="ThemeChoice" l:Localize.Header="外观主题" l:Localize.Name="外观主题"><ComboBoxItem l:Localize.Content="跟随系统" /><ComboBoxItem l:Localize.Content="浅色" /><ComboBoxItem l:Localize.Content="深色" /></ComboBox>
    <ComboBox x:Name="LayoutChoice" MaxWidth="360" HorizontalAlignment="Stretch" SelectionChanged="OnAppearance" AutomationProperties.AutomationId="LayoutChoice" l:Localize.Header="书架视图" l:Localize.Name="书架默认视图"><ComboBoxItem l:Localize.Content="网格" /><ComboBoxItem l:Localize.Content="列表" /></ComboBox>
    <ComboBox x:Name="MaterialChoice" MaxWidth="360" HorizontalAlignment="Stretch" SelectionChanged="OnMaterialMode" AutomationProperties.AutomationId="MaterialChoice" l:Localize.Header="材质效果"><ComboBoxItem l:Localize.Content="自动" /><ComboBoxItem l:Localize.Content="日常玻璃" /><ComboBoxItem l:Localize.Content="标准" /></ComboBox>
    <TextBlock x:Name="MaterialState" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="MaterialState" AutomationProperties.LiveSetting="Polite" />
    <Expander HorizontalAlignment="Stretch" l:Localize.Header="材质与系统策略"><TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" l:Localize.Text="自动与日常玻璃在背景稳定、设备支持时使用无色散的日常玻璃；标准使用 Windows 亚克力材质。系统透明效果、节电、远程桌面与高对比度优先于应用选项。" /></Expander>
   </StackPanel>
   <Border Height="1" Background="{ThemeResource DividerBrush}" />
   <StackPanel Spacing="16">
    <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="在线目录 · NextMoe" />
     <ToggleSwitch x:Name="NsfwSwitch" Toggled="OnNsfw" AutomationProperties.AutomationId="CatalogNsfw" l:Localize.Header="显示 NSFW 内容" l:Localize.OnContent="显示" l:Localize.OffContent="隐藏" l:Localize.Name="显示 NSFW 内容" />
     <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" l:Localize.Text="仅影响搜索与标签相关作品，按 KunGal 分类过滤；书架中的作品和资料始终保留。" />
     <TextBlock Text="{x:Bind Browsing.Message, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="CatalogBrowseState" AutomationProperties.LiveSetting="Polite" />
    <StackPanel x:Name="CredentialEditor" Spacing="12" Visibility="Collapsed">
     <PasswordBox x:Name="ApiCredential" PasswordRevealMode="Hidden" MaxLength="4096" MaxWidth="480" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="OnlineCredential" l:Localize.Header="当前资料的 API 密钥" l:Localize.Name="当前资料的在线目录 API 密钥" />
     <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="OnSaveCredential" l:Localize.Content="保存密钥" /><Button x:Name="CancelCredentialButton" Click="OnCancelCredential" l:Localize.Content="取消" /></StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ChangeCredentialButton" Click="OnChangeCredential" Visibility="Collapsed" l:Localize.Content="更换密钥" /><Button x:Name="RemoveCredentialButton" Click="OnClearCredential" Visibility="Collapsed" l:Localize.Content="移除密钥" /><Button Click="OnTestConnection" l:Localize.Content="测试连接" /></StackPanel>
    <TextBlock Text="{x:Bind Online.CredentialMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{x:Bind Online.ConnectionMessage, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
   </StackPanel>
   <Border Height="1" Background="{ThemeResource DividerBrush}" />
   <StackPanel Spacing="16">
    <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="导入与识别" />
    <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" l:Localize.Text="导入后自动识别；身份、版本与唯一领先条件均满足时自动应用，其余建议在作品详情中核对。" />
    <ToggleSwitch IsOn="{x:Bind Recognition.UseOnline, Mode=TwoWay}" AutomationProperties.AutomationId="RecognitionOnline" l:Localize.Header="在线补充" l:Localize.OnContent="启用" l:Localize.OffContent="仅本地" />
    <ToggleSwitch IsOn="{x:Bind Recognition.IncludePe, Mode=TwoWay}" AutomationProperties.AutomationId="RecognitionPe" l:Localize.Header="程序版本线索" l:Localize.OnContent="只读有界版本资源" l:Localize.OffContent="只用文件名" />
    <TextBlock Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" l:Localize.Text="不会运行游戏；读取程序资源也可能触发系统安全扫描。选项保存在当前资料，下次识别开始时生效。" />
    <TextBlock Text="{x:Bind Recognition.ProgressText, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionProgress" />
    <TextBlock Text="{x:Bind Recognition.Message, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Text="{x:Bind Recognition.PersistenceError, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource WarningTextBrush}" />
    <StackPanel Orientation="Horizontal" Spacing="8"><Button Click="OnMissing" AutomationProperties.AutomationId="RecognizeMissing" l:Localize.Content="补全缺失资料" /><Button Click="OnCancelRecognition" AutomationProperties.AutomationId="RecognitionCancel" l:Localize.Content="取消本轮识别" /></StackPanel>
   </StackPanel>
   <Expander HorizontalAlignment="Stretch" l:Localize.Header="资料存储"><StackPanel Spacing="12"><TextBlock Text="{x:Bind ViewModel.DataDirectory}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DataDirectory" /><TextBlock Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" l:Localize.Text="当前资料的数据、偏好与密钥相互隔离。书架修改通过完整事务保存，不会自动导入旧 Electron 资料。" /></StackPanel></Expander>
   <TextBlock Style="{StaticResource MetadataTextStyle}" Text="{x:Bind AppVersion}" AutomationProperties.AutomationId="AppVersion" IsTextSelectionEnabled="True" />
  </StackPanel>
 </ScrollViewer>
</Page>
