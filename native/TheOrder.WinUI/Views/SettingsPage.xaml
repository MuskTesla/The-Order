<Page x:Class="TheOrder.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer><StackPanel Padding="28" Spacing="20" MaxWidth="760" HorizontalAlignment="Left">
    <TextBlock Text="设置" Style="{ThemeResource TitleTextBlockStyle}" />
    <ComboBox x:Name="ThemeChoice" Header="外观主题（仅本次运行）" Width="240" SelectionChanged="OnThemeChanged" AutomationProperties.AutomationId="ThemeChoice"><ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" /></ComboBox>
    <TextBlock Text="合成资料目录" FontWeight="SemiBold" />
    <TextBlock Text="{x:Bind DataDirectory}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DataDirectory" />
    <TextBlock Text="此候选仅只读加载明确指定并带合成标记的资料。不会保存书架、读取旧设置或访问 API 密钥。" TextWrapping="Wrap" />
    <TextBlock Text="The Order · WinUI 3 / Phase 1 · x64" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
  </StackPanel></ScrollViewer>
</Page>
