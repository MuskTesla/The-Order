<?xml version="1.0" encoding="utf-8"?><Page x:Class="TheOrder.WinUI.Views.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:l="using:TheOrder.WinUI.Localization" xmlns:p="using:TheOrder.Presentation" xmlns:views="using:TheOrder.WinUI.Views">
 <Grid x:Name="SettingsRoot" SizeChanged="OnSettingsSizeChanged">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
  <StackPanel x:Name="SettingsColumn" Padding="{StaticResource PagePadding}" Spacing="16" MaxWidth="900" HorizontalAlignment="Left">
   <TextBlock Style="{StaticResource PageTitleStyle}" l:Localize.Text="设置" />
   <Border Style="{StaticResource SurfaceStyle}" Padding="20">
    <StackPanel Spacing="16">
     <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="外观与浏览" />
     <StackPanel x:Name="LanguageOptions" Spacing="8" Visibility="Collapsed">
      <ComboBox x:Name="LanguageChoice" MaxWidth="400" Width="400" HorizontalAlignment="Left" SelectionChanged="OnLanguage" AutomationProperties.AutomationId="LanguageChoice" l:Localize.Header="界面语言" l:Localize.Name="界面语言"><ComboBoxItem l:Localize.Content="跟随系统" /><ComboBoxItem l:Localize.Content="简体中文" /><ComboBoxItem l:Localize.Content="繁體中文" /><ComboBoxItem l:Localize.Content="日本語" /><ComboBoxItem Content="English" /></ComboBox>
      <TextBlock Text="{x:Bind Languages.Message, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="LanguageState" AutomationProperties.LiveSetting="Polite" />
     </StackPanel>
     <StackPanel Spacing="8">
      <ComboBox x:Name="ContentLanguageChoice" Header="资料首选语言" MaxWidth="400" Width="400" HorizontalAlignment="Left" SelectionChanged="OnContentLanguage" IsEnabled="{x:Bind ContentLanguages.CanChange, Mode=OneWay}" AutomationProperties.AutomationId="ContentLanguageChoice"><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="繁體中文" /><ComboBoxItem Content="日本語" /><ComboBoxItem Content="English" /><ComboBoxItem Content="原文" /></ComboBox>
      <ComboBox x:Name="ContentFallbackChoice" Header="缺少译文时优先使用" MaxWidth="400" Width="400" HorizontalAlignment="Left" SelectionChanged="OnContentLanguage" IsEnabled="{x:Bind ContentLanguages.CanChange, Mode=OneWay}" AutomationProperties.AutomationId="ContentFallbackChoice"><ComboBoxItem Content="简体中文" /><ComboBoxItem Content="繁體中文" /><ComboBoxItem Content="日本語" /><ComboBoxItem Content="English" /><ComboBoxItem Content="原文" /></ComboBox>
      <TextBlock Text="{x:Bind ContentLanguages.Message, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ContentLanguageState" AutomationProperties.LiveSetting="Polite" />
     </StackPanel>
     <ComboBox x:Name="ThemeChoice" MaxWidth="400" Width="400" HorizontalAlignment="Left" SelectionChanged="OnAppearance" AutomationProperties.AutomationId="ThemeChoice" l:Localize.Header="外观主题" l:Localize.Name="外观主题"><ComboBoxItem l:Localize.Content="跟随系统" /><ComboBoxItem l:Localize.Content="浅色" /><ComboBoxItem l:Localize.Content="深色" /></ComboBox>
     <ComboBox x:Name="MaterialChoice" MaxWidth="400" Width="400" HorizontalAlignment="Left" SelectionChanged="OnMaterialMode" AutomationProperties.AutomationId="MaterialChoice" l:Localize.Header="材质效果"><ComboBoxItem l:Localize.Content="自动" /><ComboBoxItem l:Localize.Content="日常玻璃" /><ComboBoxItem l:Localize.Content="标准" /></ComboBox>
     <TextBlock x:Name="MaterialError" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource WarningTextBrush}" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceStyle}" Padding="20">
    <StackPanel x:Name="LaunchDefaultsSection" Spacing="16" AutomationProperties.AutomationId="GlobalLaunchSettings">
     <TextBlock Text="游戏启动与辅助工具" Style="{StaticResource SectionTitleStyle}" />
     <TextBlock Text="为跟随全局设置的游戏选择默认行为；工具路径只需在这里设置一次。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
     <StackPanel Spacing="8">
      <ToggleSwitch IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Header="Locale Emulator · 日文转区" IsOn="{x:Bind LaunchDefaults.LocaleEmulatorEnabled, Mode=TwoWay}" OnContent="默认开启" OffContent="默认关闭" AutomationProperties.AutomationId="GlobalLocaleEnabled" />
      <Expander x:Name="GlobalLocaleToolSection" Header="Locale Emulator 工具位置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="GlobalLocaleToolSection"><StackPanel Spacing="8">
      <TextBox IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Header="LEProc.exe 路径" PlaceholderText="选择已安装的 Locale Emulator" Text="{x:Bind LaunchDefaults.LocaleEmulatorPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="32768" AutomationProperties.AutomationId="GlobalLocalePath" />
      <Button IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Content="选择 LEProc.exe…" Click="OnChooseGlobalLocale" HorizontalAlignment="Left" />
      </StackPanel></Expander>
     </StackPanel>
     <Border Height="1" Background="{ThemeResource DividerBrush}" />
     <StackPanel Spacing="8">
      <ToggleSwitch IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Header="Magpie · 窗口缩放" IsOn="{x:Bind LaunchDefaults.MagpieEnabled, Mode=TwoWay}" OnContent="默认开启" OffContent="默认关闭" AutomationProperties.AutomationId="GlobalMagpieEnabled" />
      <Expander x:Name="GlobalMagpieToolSection" Header="Magpie 工具位置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="GlobalMagpieToolSection"><StackPanel Spacing="8">
      <TextBox IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Header="Magpie.exe 路径" PlaceholderText="选择已安装的 Magpie" Text="{x:Bind LaunchDefaults.MagpiePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="32768" AutomationProperties.AutomationId="GlobalMagpiePath" />
      <Button IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Content="选择 Magpie.exe…" Click="OnChooseGlobalMagpie" HorizontalAlignment="Left" />
      </StackPanel></Expander>
      <TextBlock Text="启动游戏时打开 Magpie；缩放模式和快捷键在 Magpie 中设置。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
     </StackPanel>
     <Border Height="1" Background="{ThemeResource DividerBrush}" />
     <StackPanel Spacing="8">
      <ToggleSwitch IsEnabled="{x:Bind LaunchDefaults.CanChange, Mode=OneWay}" Header="后台静音" IsOn="{x:Bind LaunchDefaults.BackgroundMuteEnabled, Mode=TwoWay}" OnContent="默认开启" OffContent="默认关闭" AutomationProperties.AutomationId="GlobalMuteEnabled" />
      <TextBlock Text="仅静音正在跟踪的游戏，切回游戏或结束后恢复；保留原有静音状态。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
     </StackPanel>
     <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8">
      <Button Content="保存启动设置" Click="OnSaveLaunchDefaults" IsEnabled="{x:Bind LaunchDefaults.CanSave, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SaveGlobalLaunch" />
      <Button Content="放弃修改" Click="OnCancelLaunchDefaults" IsEnabled="{x:Bind LaunchDefaults.CanSave, Mode=OneWay}" AutomationProperties.AutomationId="CancelGlobalLaunch" />
     </views:TagFlowPanel>
     <TextBlock Text="{x:Bind LaunchDefaults.Message, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="GlobalLaunchState" />
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceStyle}" Padding="20">
    <StackPanel x:Name="NextMoeSection" Spacing="12">
     <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="在线目录 · NextMoe" />
     <ComboBox x:Name="NextMoeAccessChoice" Header="访问方式" MaxWidth="400" Width="400" HorizontalAlignment="Left" SelectionChanged="OnNextMoeAccess" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="NextMoeAccessMode"><ComboBoxItem Content="匿名访问（默认）" /><ComboBoxItem Content="NextMoe 账号" /><ComboBoxItem Content="自定义 API Key" /></ComboBox>
     <TextBlock Text="{x:Bind NextMoe.AccessMessage, Mode=OneWay}" Visibility="{x:Bind VisibleText(NextMoe.AccessMessage), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="NextMoeAccessState" />
     <TextBlock x:Name="NextMoeAccountText" Text="{x:Bind NextMoe.AccountName, Mode=OneWay}" Visibility="{x:Bind VisibleText(NextMoe.AccountName), Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="NextMoeAccount" />
     <Button x:Name="RecoverLoginButton" Content="重置本机登录…" Click="OnRecoverLogin" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" HorizontalAlignment="Left" Visibility="Collapsed" />
     <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="登录 / 重新登录 NextMoe" Click="OnNextMoeLogin" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="NextMoeLogin" /><Button Content="退出本机登录" Click="OnNextMoeLogout" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="NextMoeLogout" /><Button Click="OnTestConnection" Content="测试当前访问方式" /><Button Content="取消当前操作" Click="OnCancelNextMoe" Visibility="{x:Bind Visible(NextMoe.Busy), Mode=OneWay}" AutomationProperties.AutomationId="NextMoeCancel" /></views:TagFlowPanel>
     <TextBlock Text="{x:Bind Online.ConnectionMessage, Mode=OneWay}" Visibility="{x:Bind VisibleConnectionMessage(Online.ConnectionMessage), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
     <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,2" />
     <ToggleSwitch x:Name="NsfwSwitch" Toggled="OnNsfw" AutomationProperties.AutomationId="CatalogNsfw" l:Localize.Header="显示 NSFW 内容" l:Localize.OnContent="显示" l:Localize.OffContent="隐藏" l:Localize.Name="显示 NSFW 内容" />
     <TextBlock Text="{x:Bind OperationalMessage(Browsing.Message), Mode=OneWay}" Visibility="{x:Bind VisibleOperationalMessage(Browsing.Message), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="CatalogBrowseState" AutomationProperties.LiveSetting="Polite" />
     <Expander x:Name="ApiKeyPanel" Header="高级 · 自定义 API Key" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Expanding="OnApiKeyPanelExpanding" SizeChanged="OnSettingsSectionSizeChanged"><StackPanel Spacing="12">
      <HyperlinkButton Content="获取 API Key" NavigateUri="https://developer.nextmoe.dev/" HorizontalAlignment="Left" />
      <StackPanel x:Name="CredentialEditor" Spacing="12" Visibility="Collapsed" SizeChanged="OnSettingsSectionSizeChanged">
       <PasswordBox x:Name="ApiCredential" PasswordRevealMode="Hidden" MaxLength="4096" MaxWidth="480" Width="480" HorizontalAlignment="Left" Loaded="OnSettingsControlLoaded" AutomationProperties.AutomationId="OnlineCredential" l:Localize.Header="当前资料的 API 密钥" l:Localize.Name="当前资料的在线目录 API 密钥" />
       <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Click="OnSaveCredential" Style="{StaticResource AccentButtonStyle}" l:Localize.Content="保存密钥" /><Button x:Name="CancelCredentialButton" Click="OnCancelCredential" l:Localize.Content="取消" /></views:TagFlowPanel>
      </StackPanel>
      <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8"><Button x:Name="ChangeCredentialButton" Click="OnChangeCredential" Visibility="Collapsed" l:Localize.Content="更换密钥" /><Button x:Name="RemoveCredentialButton" Click="OnClearCredential" Visibility="Collapsed" l:Localize.Content="移除密钥" /></views:TagFlowPanel>
      <TextBlock Text="{x:Bind Online.CredentialMessage, Mode=OneWay}" Visibility="{x:Bind VisibleText(Online.CredentialMessage), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
     </StackPanel></Expander>
     <StackPanel x:Name="PersonalSyncPanel" Spacing="12" Visibility="Collapsed" SizeChanged="OnSettingsSectionSizeChanged" AutomationProperties.AutomationId="NextMoePersonalSync">
      <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,4" />
      <TextBlock Text="个人数据同步" Style="{StaticResource SectionTitleStyle}" />
      <ComboBox Header="游玩时长" SelectedIndex="{x:Bind NextMoe.TimeDirection, Mode=TwoWay}" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" MaxWidth="400" Width="400" HorizontalAlignment="Left" AutomationProperties.AutomationId="SyncPlaytime"><ComboBoxItem Content="关闭" /><ComboBoxItem Content="从云端导入" /><ComboBoxItem Content="上传到云端" /><ComboBoxItem Content="双向同步" /></ComboBox>
      <ComboBox Header="游玩状态" SelectedIndex="{x:Bind NextMoe.StateDirection, Mode=TwoWay}" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" MaxWidth="400" Width="400" HorizontalAlignment="Left" AutomationProperties.AutomationId="SyncState"><ComboBoxItem Content="关闭" /><ComboBoxItem Content="从云端导入" /><ComboBoxItem Content="上传到云端" /><ComboBoxItem Content="双向同步" /></ComboBox>
      <ComboBox Header="收藏夹" SelectedIndex="{x:Bind NextMoe.FolderDirection, Mode=TwoWay}" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" MaxWidth="400" Width="400" HorizontalAlignment="Left" AutomationProperties.AutomationId="SyncFolders"><ComboBoxItem Content="关闭" /><ComboBoxItem Content="从云端导入" /><ComboBoxItem Content="上传到云端" /><ComboBoxItem Content="双向同步" /></ComboBox>
      <CheckBox Content="读取云端评分（只读，不替换本地评分）" IsChecked="{x:Bind NextMoe.ReadRatings, Mode=TwoWay}" AutomationProperties.AutomationId="SyncRatings" />
      <CheckBox Content="自动同步已确认的项目" IsChecked="{x:Bind NextMoe.Automatic, Mode=TwoWay}" AutomationProperties.AutomationId="SyncAutomatic" />
      <Button Content="暂停自动同步" Click="OnPauseSync" HorizontalAlignment="Left" AutomationProperties.AutomationId="SyncPause" />
      <TextBlock Text="{x:Bind NextMoe.LastSync, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" />
      <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="预览差异" Click="OnPreviewSync" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="SyncPreview" /><Button Content="授权收藏夹访问" Click="OnFolderPermission" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" /><Button x:Name="SyncRetryButton" Content="恢复检查 / 重试" Click="OnRetrySync" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="SyncRetry" /></views:TagFlowPanel>
      <Button x:Name="SyncReviewPendingButton" Content="核对并结束旧任务…" Click="OnReviewPending" HorizontalAlignment="Left" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" />
      <StackPanel x:Name="SyncFolderPicker" Spacing="12"><ComboBox x:Name="SyncFolderChoice" Header="选择云端收藏夹" ItemsSource="{x:Bind NextMoe.Folders}" DisplayMemberPath="Name" MaxWidth="400" Width="400" HorizontalAlignment="Left" />
       <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="设置本地成员" Click="OnMapSyncFolder" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" /><Button Content="创建云端收藏夹" Click="OnCreateSyncFolder" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" /></views:TagFlowPanel>
       <ComboBox x:Name="MappedFolderChoice" Header="已关联的收藏列表" ItemsSource="{x:Bind NextMoe.Mappings}" DisplayMemberPath="Name" MaxWidth="400" Width="400" HorizontalAlignment="Left" /><Button Content="取消这项关联…" Click="OnUnmapFolder" HorizontalAlignment="Left" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" />
      </StackPanel><TextBlock Text="{x:Bind NextMoe.PreviewSummary, Mode=OneWay}" Visibility="{x:Bind VisibleText(NextMoe.PreviewSummary), Mode=OneWay}" TextWrapping="Wrap" />
      <ListView x:Name="SyncPreviewRows" ItemsSource="{x:Bind NextMoe.Rows}" MaxHeight="520" SelectionMode="None" SizeChanged="OnSettingsSectionSizeChanged" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.IsVerticalScrollChainingEnabled="True" AutomationProperties.AutomationId="SyncPreviewRows">
       <ListView.ItemTemplate><DataTemplate x:DataType="p:SyncRowView"><StackPanel Spacing="6" Padding="4,10" HorizontalAlignment="Stretch"><TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Values}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Explanation}" TextWrapping="Wrap" Style="{StaticResource MetadataTextStyle}" /><ComboBox SelectedIndex="{x:Bind Choice, Mode=TwoWay}" MaxWidth="400" Width="400" HorizontalAlignment="Left"><ComboBoxItem Content="跳过" /><ComboBoxItem Content="从云端导入" /><ComboBoxItem Content="上传本地 / 明确移除云端成员" /></ComboBox></StackPanel></DataTemplate></ListView.ItemTemplate>
      </ListView>
      <CheckBox x:Name="SyncRemovalCheck" Content="我确认：仅对本次明确选中的移除项目删除云端收藏成员（不删除本地作品或游戏文件）" IsChecked="{x:Bind NextMoe.ConfirmCloudRemoval, Mode=TwoWay}" AutomationProperties.AutomationId="SyncConfirmRemoval" />
      <Button x:Name="SyncApplyButton" Content="确认同步所选项目" Click="OnApplySync" IsEnabled="{x:Bind NextMoe.CanOperate, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SyncApply" />
      <ProgressBar Value="{x:Bind NextMoe.Progress, Mode=OneWay}" Visibility="{x:Bind Visible(NextMoe.Busy), Mode=OneWay}" Maximum="100" Minimum="0" />
     </StackPanel>
     <TextBlock Text="{x:Bind NextMoe.Message, Mode=OneWay}" Visibility="{x:Bind VisibleText(NextMoe.Message), Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="NextMoeSyncState" AutomationProperties.LiveSetting="Polite" />
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceStyle}" Padding="20">
    <StackPanel x:Name="BangumiSection" Spacing="12" AutomationProperties.AutomationId="BangumiAuthorizationSection">
     <TextBlock Text="番组计划 · 关联作品" Style="{StaticResource SectionTitleStyle}" />
     <TextBlock Text="{x:Bind Bangumi.Status, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="BangumiAuthorizationStatus" />
     <TextBlock Text="授权后可读取番组计划允许访问的受限条目及其关联。" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
     <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8">
      <Button Content="{x:Bind Bangumi.ConnectionAction, Mode=OneWay}" Click="OnBangumiQuickLogin" IsEnabled="{x:Bind Bangumi.CanQuickLogin, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BangumiQuickLogin" />
      <Button Content="手动令牌授权…" Click="OnBangumiAuthorize" IsEnabled="{x:Bind Bangumi.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="BangumiAuthorize" />
      <Button Content="验证授权" Click="OnBangumiTest" IsEnabled="{x:Bind Bangumi.CanTest, Mode=OneWay}" Visibility="{x:Bind Visible(Bangumi.HasAuthorization), Mode=OneWay}" AutomationProperties.AutomationId="BangumiTestAuthorization" />
      <Button Content="断开连接" Click="OnBangumiRemove" IsEnabled="{x:Bind Bangumi.CanOperate, Mode=OneWay}" Visibility="{x:Bind Visible(Bangumi.HasAuthorization), Mode=OneWay}" AutomationProperties.AutomationId="BangumiRemoveAuthorization" />
      <Button Content="取消" Click="OnBangumiCancel" Visibility="{x:Bind Visible(Bangumi.Busy), Mode=OneWay}" AutomationProperties.AutomationId="BangumiCancelAuthorization" />
     </views:TagFlowPanel>
     <TextBlock Text="{x:Bind Bangumi.QuickLoginNotice, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind VisibleText(Bangumi.QuickLoginNotice), Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" AutomationProperties.AutomationId="BangumiQuickLoginNotice" />
     <StackPanel x:Name="BangumiEditor" Spacing="10" Visibility="Collapsed" SizeChanged="OnSettingsSectionSizeChanged">
      <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,2" />
      <HyperlinkButton Content="在番组计划获取访问令牌" NavigateUri="https://next.bgm.tv/demo/access-token" HorizontalAlignment="Left" AutomationProperties.AutomationId="BangumiTokenPage" />
      <TextBlock Text="在官方页面生成并复制访问令牌，粘贴到下方后保存。" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
      <PasswordBox x:Name="BangumiToken" Header="番组计划访问令牌" PasswordRevealMode="Hidden" MaxLength="4096" MaxWidth="480" Width="480" HorizontalAlignment="Left" Loaded="OnSettingsControlLoaded" IsEnabled="{x:Bind Bangumi.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="BangumiAccessToken" />
      <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Content="保存并验证" Click="OnBangumiSave" IsEnabled="{x:Bind Bangumi.CanOperate, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="BangumiSaveAuthorization" /><Button Content="收起" Click="OnBangumiCancelEditor" AutomationProperties.AutomationId="BangumiCloseEditor" /></views:TagFlowPanel>
     </StackPanel>
     <TextBlock Text="{x:Bind Bangumi.Message, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind VisibleText(Bangumi.Message), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="BangumiAuthorizationMessage" />
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceStyle}" Padding="20">
    <StackPanel Spacing="16">
     <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="导入与识别" />
     <Button Content="自动发现游戏（文件夹 / Steam）…" Click="OnLibrarySources" HorizontalAlignment="Left" AutomationProperties.AutomationId="ManageLibrarySources" />
     <ToggleSwitch IsOn="{x:Bind Recognition.UseOnline, Mode=TwoWay}" AutomationProperties.AutomationId="RecognitionOnline" l:Localize.Header="在线补充" l:Localize.OnContent="启用" l:Localize.OffContent="仅本地" />
     <ToggleSwitch IsOn="{x:Bind Recognition.IncludePe, Mode=TwoWay}" AutomationProperties.AutomationId="RecognitionPe" l:Localize.Header="程序版本线索" l:Localize.OnContent="启用" l:Localize.OffContent="关闭" />
     <StackPanel Spacing="8" Visibility="{x:Bind Visible(Recognition.HasRecognitionWork), Mode=OneWay}" AutomationProperties.AutomationId="RecognitionActivity">
      <TextBlock Text="{x:Bind Recognition.ProgressText, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionProgress" />
      <TextBlock Text="{x:Bind Recognition.Message, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind VisibleText(Recognition.Message), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
     </StackPanel>
     <TextBlock Text="{x:Bind Recognition.PersistenceError, Mode=OneWay}" Visibility="{x:Bind VisibleText(Recognition.PersistenceError), Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource WarningTextBrush}" />
     <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8"><Button Click="OnMissing" AutomationProperties.AutomationId="RecognizeMissing" l:Localize.Content="补全缺失资料" /><Button Click="OnCancelRecognition" Visibility="{x:Bind Visible(Recognition.HasRecognitionWork), Mode=OneWay}" AutomationProperties.AutomationId="RecognitionCancel" l:Localize.Content="取消本轮识别" /></views:TagFlowPanel>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceStyle}" Padding="20">
    <StackPanel Spacing="16" AutomationProperties.AutomationId="LibraryBackupSection">
     <TextBlock Style="{StaticResource SectionTitleStyle}" Text="备份与恢复" />
     <TextBlock Text="备份作品资料和游玩记录，不包含游戏本体或存档文件。" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
     <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8">
      <Button Content="导出书架备份…" Click="OnExportBackup" IsEnabled="{x:Bind Backups.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="ExportLibraryBackup" />
      <Button Content="从备份恢复…" Click="OnRestoreBackup" IsEnabled="{x:Bind Backups.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="RestoreLibraryBackup" />
      <Button x:Name="RestoreAutomaticBackup" Content="查看自动备份" Click="OnRestoreAutomaticBackup" IsEnabled="{x:Bind Backups.CanOperate, Mode=OneWay}" AutomationProperties.AutomationId="RestoreAutomaticBackup" />
     </views:TagFlowPanel>
     <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,2" />
     <ToggleSwitch x:Name="AutomaticBackup" Header="自动备份" OnContent="开启" OffContent="关闭" Toggled="OnAutomaticBackup" IsEnabled="{x:Bind Backups.CanChangeAutomatic, Mode=OneWay}" AutomationProperties.AutomationId="AutomaticLibraryBackup" />
     <TextBlock Text="{x:Bind Backups.LastBackup, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
     <TextBlock Text="{x:Bind Backups.Message, Mode=OneWay}" Visibility="{x:Bind VisibleText(Backups.Message), Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" AutomationProperties.AutomationId="LibraryBackupMessage" />
     <Expander HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" l:Localize.Header="资料存储"><TextBlock Text="{x:Bind ViewModel.DataDirectory}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="DataDirectory" /></Expander>
    </StackPanel>
   </Border>
   <Border Style="{StaticResource SurfaceStyle}" Padding="20">
    <StackPanel x:Name="UpdateSection" Spacing="12" AutomationProperties.AutomationId="AppUpdates">
     <TextBlock Text="程序更新" Style="{StaticResource SectionTitleStyle}" />
      <ComboBox x:Name="UpdateChannelChoice" Header="更新通道" HorizontalAlignment="Left" MinWidth="220" MaxWidth="420" HorizontalContentAlignment="Left" SelectionChanged="OnUpdateChannel" IsEnabled="{x:Bind Updates.CanChangeChannel, Mode=OneWay}" AutomationProperties.AutomationId="UpdateChannelChoice">
       <ComboBoxItem Content="正式版（推荐）" /><ComboBoxItem Content="Beta 公开测试" />
      </ComboBox>
      <TextBlock Text="{x:Bind Updates.ChannelNotice, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" />
     <TextBlock Text="{x:Bind Updates.VersionText, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="UpdateVersion" />
     <TextBlock Text="{x:Bind Updates.Message, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" AutomationProperties.AutomationId="UpdateState" AutomationProperties.LiveSetting="Polite" />
     <ProgressBar x:Name="UpdateProgress" Value="{x:Bind Updates.Progress, Mode=OneWay}" IsIndeterminate="{x:Bind Updates.Indeterminate, Mode=OneWay}" Minimum="0" Maximum="100" Visibility="Collapsed" AutomationProperties.AutomationId="UpdateProgress" />
     <TextBlock x:Name="UpdateHighlights" Text="{x:Bind Updates.Highlights, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" AutomationProperties.AutomationId="UpdateHighlights" />
     <Expander x:Name="UpdateNotes" Header="完整更新说明" HorizontalAlignment="Stretch" Visibility="Collapsed"><TextBlock Text="{x:Bind Updates.Notes, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource SecondaryTextStyle}" /></Expander>
     <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8">
      <Button Click="OnCheckUpdate" Content="检查更新" IsEnabled="{x:Bind Updates.CanCheck, Mode=OneWay}" AutomationProperties.AutomationId="CheckAppUpdate" />
      <HyperlinkButton Content="GitHub 发布与反馈 ↗" NavigateUri="https://github.com/Ph-Rank/The-Order/releases" AutomationProperties.AutomationId="PublicReleasePage" />
       <Button x:Name="InstallUpdateButton" Click="OnInstallUpdate" Content="{x:Bind Updates.InstallText, Mode=OneWay}" IsEnabled="{x:Bind Updates.CanInstall, Mode=OneWay}" Visibility="Collapsed" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="InstallAppUpdate" />
      <Button x:Name="CancelUpdateButton" Click="OnCancelUpdate" Content="取消" Visibility="Collapsed" IsEnabled="{x:Bind Updates.CanCancel, Mode=OneWay}" AutomationProperties.AutomationId="CancelAppUpdate" />
     </views:TagFlowPanel>
     <TextBlock x:Name="UpdateInstallNotice" Text="{x:Bind Updates.InstallAvailability}" TextWrapping="Wrap" Style="{StaticResource MetadataTextStyle}" Visibility="Collapsed" />
    </StackPanel>
   </Border>
   <TextBlock Style="{StaticResource MetadataTextStyle}" Text="{x:Bind AppVersion}" AutomationProperties.AutomationId="AppVersion" IsTextSelectionEnabled="True" />
  </StackPanel>
 </ScrollViewer>
 </Grid>
</Page>
