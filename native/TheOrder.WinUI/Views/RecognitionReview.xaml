<?xml version="1.0" encoding="utf-8"?><UserControl x:Class="TheOrder.WinUI.Views.RecognitionReview" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:p="using:TheOrder.Presentation" xmlns:local="using:TheOrder.WinUI.Views" xmlns:l="using:TheOrder.WinUI.Localization">
<StackPanel Spacing="16">
     <TextBlock Style="{StaticResource SectionTitleStyle}" l:Localize.Text="识别核对" />
     <TextBlock Text="{x:Bind ViewModel.SelectedMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="RecognitionSelectedState" AutomationProperties.LiveSetting="Polite" />
     <Expander HorizontalAlignment="Stretch" l:Localize.Header="识别依据与本地线索"><TextBlock Text="{x:Bind ViewModel.LocalFacts, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="RecognitionLocalFacts" /></Expander>
     <Grid x:Name="ReviewActions" ColumnSpacing="8" HorizontalAlignment="Left"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Button Click="OnRerun" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRerun" l:Localize.Content="重新识别" /><Button x:Name="IgnoreReviewButton" Grid.Row="1" Click="OnIgnore" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionIgnore" l:Localize.Content="忽略本次建议" />
     </Grid>
     <ListView x:Name="CandidateList" MaxHeight="420" ScrollViewer.IsVerticalScrollChainingEnabled="True" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectedItem="{x:Bind ViewModel.SelectedCandidateItem, Mode=OneWay}" SelectionMode="Single" SelectionChanged="OnCandidate" AutomationProperties.AutomationId="RecognitionCandidates" l:Localize.Name="待核对的目录作品候选">
      <ListView.ItemTemplate><DataTemplate x:DataType="p:RecognitionCandidateCard"><StackPanel Padding="12" Spacing="8"><TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" Style="{StaticResource CardTitleStyle}" /><TextBlock Text="{x:Bind Summary}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Evidence}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Text="{x:Bind Conflicts}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" Foreground="{ThemeResource WarningTextBrush}" /><Button Tag="{x:Bind Id}" Click="OnRemoteDetails" l:Localize.Content="查看候选详情" /></StackPanel></DataTemplate></ListView.ItemTemplate>
     </ListView>
     <Button Click="OnApply" IsEnabled="{x:Bind ViewModel.CanConfirmSelection, Mode=OneWay}" Content="{x:Bind ViewModel.ConfirmSelectionText, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RecognitionApply" />
     <Grid x:Name="ManualActions" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <TextBox x:Name="ManualIdBox" Text="{x:Bind ViewModel.ManualId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="20" AutomationProperties.AutomationId="RecognitionManualId" l:Localize.Header="手动关联 · 目录作品编号" l:Localize.PlaceholderText="先核对目标作品与版本" l:Localize.Name="手动关联的目录作品编号" /><Button x:Name="ManualApplyButton" Grid.Row="1" VerticalAlignment="Bottom" Click="OnManual" IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionManualApply" l:Localize.Content="确认手动关联" />
     </Grid>
     <local:CoverPresenter SourceKey="{x:Bind ViewModel.RemoteCoverKey, Mode=OneWay}" Width="140" Height="190" HorizontalAlignment="Left" />
      <local:MarkdownView x:Name="RemoteRichFacts" Text="{x:Bind ViewModel.RemoteFacts, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRemoteFacts" />
     <ItemsControl ItemsSource="{x:Bind ViewModel.RemoteLinks, Mode=OneWay}" AutomationProperties.AutomationId="RecognitionRemoteLinks">
      <ItemsControl.ItemTemplate><DataTemplate x:DataType="p:CandidateDetailLink"><StackPanel Spacing="4"><HyperlinkButton Content="{x:Bind Title}" Tag="{x:Bind Url}" Click="OnOpenLink" HorizontalAlignment="Left" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
</UserControl>
