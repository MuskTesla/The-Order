<?xml version="1.0" encoding="utf-8"?><Page x:Class="TheOrder.WinUI.Views.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:TheOrder.Application" xmlns:l="using:TheOrder.WinUI.Localization">
 <Grid Padding="{StaticResource PagePadding}" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Style="{StaticResource PageTitleStyle}" l:Localize.Text="导入本地游戏" /><TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" l:Localize.Text="选择导入后立即自动识别；排序分严格大于 0.9、身份与版本一致且唯一领先时自动应用。歧义或证据不足的结果在作品详情中核对。不会执行或修改游戏文件。" /></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource ToolbarSurfaceStyle}" Padding="16"><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="44" MaximumRowsOrColumns="3"><Button Click="OnChoose" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ChooseScanRoot" l:Localize.Content="选择目录并扫描" /><Button Click="OnCancel" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}" AutomationProperties.AutomationId="CancelScan" l:Localize.Content="取消扫描" /><Button Click="OnSelectAll" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" l:Localize.Content="全选可导入候选" /></VariableSizedWrapGrid></Border>
  <StackPanel Grid.Row="2" Spacing="12"><TextBlock Text="{x:Bind ViewModel.ScanMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ScanState" AutomationProperties.LiveSetting="Polite" /><TextBlock Text="{x:Bind Recognition.Message, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ImportRecognitionState" AutomationProperties.LiveSetting="Polite" /><Button Click="OnRetry" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RetryScan" l:Localize.Content="重新检查当前目录" /><ProgressBar IsIndeterminate="True" Visibility="{x:Bind Visible(ViewModel.IsScanning), Mode=OneWay}" l:Localize.Name="正在扫描本地游戏目录" /></StackPanel>
  <Border Grid.Row="3" Style="{StaticResource SurfaceStyle}" Padding="12">
   <ListView x:Name="CandidateList" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectionMode="Multiple" AutomationProperties.AutomationId="ScanCandidates" l:Localize.Name="待导入的本地游戏候选"><ListView.ItemTemplate><DataTemplate x:DataType="app:ScanCandidate"><StackPanel Padding="12" Spacing="8"><TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Folder.StoredPath}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Evidence}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /><TextBlock Text="{x:Bind Preflight.Path.Message}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
  </Border>
  <Border Grid.Row="4" Style="{StaticResource ToolbarSurfaceStyle}" Padding="16,12"><Button Click="OnImport" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ImportSelected" l:Localize.Content="导入所选候选" /></Border>
 </Grid>
</Page>
