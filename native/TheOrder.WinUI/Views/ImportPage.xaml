<Page x:Class="TheOrder.WinUI.Views.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:TheOrder.Application">
 <Grid Padding="28" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="导入本地游戏" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="扫描只生成候选。请核对后选择导入，不会执行或修改游戏文件。" TextWrapping="Wrap"/></StackPanel>
  <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="选择目录并扫描" Click="OnChoose" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ChooseScanRoot"/><Button Content="取消扫描" Click="OnCancel" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}" AutomationProperties.AutomationId="CancelScan"/><Button Content="全选可导入候选" Click="OnSelectAll" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}"/></StackPanel>
  <StackPanel Grid.Row="2" Spacing="8"><TextBlock Text="{x:Bind ViewModel.ScanMessage, Mode=OneWay}" TextWrapping="Wrap" AutomationProperties.AutomationId="ScanState"/><Button Content="重新检查当前目录" Click="OnRetry" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RetryScan"/><ProgressBar IsIndeterminate="True" Visibility="{x:Bind Visible(ViewModel.IsScanning), Mode=OneWay}"/></StackPanel>
  <ListView Grid.Row="3" x:Name="CandidateList" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectionMode="Multiple" AutomationProperties.AutomationId="ScanCandidates"><ListView.ItemTemplate><DataTemplate x:DataType="app:ScanCandidate"><StackPanel Padding="8" Spacing="4"><TextBlock Text="{x:Bind Name}" FontWeight="SemiBold"/><TextBlock Text="{x:Bind Folder.StoredPath}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Evidence}" FontSize="12"/><TextBlock Text="{x:Bind Preflight.Path.Message}" FontSize="12"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
  <Button Grid.Row="4" Content="导入所选候选" Click="OnImport" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ImportSelected"/>
 </Grid>
</Page>
