<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="TheOrder.WinUI.Views.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:app="using:TheOrder.Application"
      xmlns:views="using:TheOrder.WinUI.Views"
      xmlns:l="using:TheOrder.WinUI.Localization">
 <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Spacing="8">
   <TextBlock Style="{StaticResource PageTitleStyle}" l:Localize.Text="导入游戏" />
   <TextBlock Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" l:Localize.Text="选择文件夹 → 勾选游戏 → 加入书架" />
   <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" l:Localize.Text="可选择单个游戏或存放多个游戏的文件夹。只记录游戏位置，不复制或移动文件。" />
  </StackPanel>
  <Border Grid.Row="1" Style="{StaticResource ToolbarSurfaceStyle}" Padding="12">
   <StackPanel Spacing="8">
    <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8" MaximumItemWidth="360">
     <Button Click="OnChoose" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ChooseScanRoot" l:Localize.Content="选择游戏文件夹…" />
     <Button Click="OnLibrarySources" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ImportLibrarySources" l:Localize.Content="从 Steam / 游戏库发现…" />
     <Button Click="OnRetry" Visibility="{x:Bind Visible(ViewModel.CanRetryScan), Mode=OneWay}" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RetryScan" l:Localize.Content="重新扫描" />
     <Button Click="OnCancel" Visibility="{x:Bind Visible(ViewModel.IsScanning), Mode=OneWay}" AutomationProperties.AutomationId="CancelScan" l:Localize.Content="取消扫描" />
    </views:TagFlowPanel>
    <TextBlock Text="{x:Bind ViewModel.ScanRoot, Mode=OneWay}" Visibility="{x:Bind Visible(ViewModel.HasScanRoot), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ScanFolder" />
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="2" Spacing="8">
   <TextBlock Text="{x:Bind ViewModel.ScanMessage, Mode=OneWay}" Visibility="{x:Bind TextVisible(ViewModel.ScanMessage), Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ScanState" AutomationProperties.LiveSetting="Polite" />
   <TextBlock Text="{x:Bind Recognition.Message, Mode=OneWay}" Visibility="{x:Bind Visible(Recognition.HasRecognitionWork), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ImportRecognitionState" AutomationProperties.LiveSetting="Polite" />
   <ProgressBar IsIndeterminate="True" Visibility="{x:Bind Visible(ViewModel.IsScanning), Mode=OneWay}" l:Localize.Name="正在查找游戏" />
  </StackPanel>
  <Border Grid.Row="3" Style="{StaticResource SurfaceStyle}" Padding="12" Visibility="{x:Bind Visible(ViewModel.HasCandidates), Mode=OneWay}">
   <Grid RowSpacing="8">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8" MaximumItemWidth="480">
     <Button x:Name="SelectAllButton" Click="OnSelectAll" AutomationProperties.AutomationId="SelectAllImportGames" l:Localize.Content="全选可导入游戏" />
     <Button x:Name="ClearSelectionButton" Click="OnClearSelection" AutomationProperties.AutomationId="ClearImportSelection" l:Localize.Content="取消全选" />
     <TextBlock x:Name="SelectionSummary" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ImportSelectionCount" AutomationProperties.LiveSetting="Polite" />
    </views:TagFlowPanel>
    <ListView x:Name="CandidateList" Grid.Row="1" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectionMode="Multiple" SelectionChanged="OnSelectionChanged" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ScanCandidates" l:Localize.Name="选择要加入书架的游戏">
     <ListView.ItemContainerStyle><Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="IsEnabled" Value="{Binding Preflight.CanAttach}" /></Style></ListView.ItemContainerStyle>
     <ListView.ItemTemplate><DataTemplate x:DataType="app:ScanCandidate"><StackPanel Padding="8" Spacing="4">
      <TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleStyle}" TextAlignment="Left" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind Folder.StoredPath}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind Preflight.Path.Message}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
     </StackPanel></DataTemplate></ListView.ItemTemplate>
    </ListView>
   </Grid>
  </Border>
  <StackPanel Grid.Row="4" Spacing="8">
   <TextBlock Visibility="{x:Bind Visible(ViewModel.IsSourceDiscovery), Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" l:Localize.Text="“不再提醒”会记住这次选择；以后可在“自动发现游戏”中恢复。" />
   <views:TagFlowPanel HorizontalSpacing="8" VerticalSpacing="8" MaximumItemWidth="360">
    <Button x:Name="ImportSelectedButton" Click="OnImport" Visibility="{x:Bind Visible(ViewModel.HasCandidates), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ImportSelected" l:Localize.Content="加入书架" />
    <Button x:Name="IgnoreSelectedButton" Click="OnIgnoreSelected" Visibility="{x:Bind Visible(ViewModel.IsSourceDiscovery), Mode=OneWay}" l:Localize.Content="所选游戏不再提醒" AutomationProperties.AutomationId="IgnoreSelectedCandidates" />
    <Button x:Name="IgnoreAllButton" Click="OnIgnoreAll" Visibility="{x:Bind Visible(ViewModel.IsSourceDiscovery), Mode=OneWay}" l:Localize.Content="全部不再提醒" AutomationProperties.AutomationId="IgnoreAllCandidates" />
    <Button Click="OnLibrary" Visibility="{x:Bind Visible(ViewModel.HasImportResult), Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="ViewImportedLibrary" l:Localize.Content="查看书架" />
   </views:TagFlowPanel>
  </StackPanel>
 </Grid>
</Page>
