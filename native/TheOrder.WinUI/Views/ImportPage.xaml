<Page x:Class="TheOrder.WinUI.Views.ImportPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:TheOrder.Application">
 <Grid Padding="{StaticResource PagePadding}" RowSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Spacing="8"><TextBlock Text="导入本地游戏" Style="{StaticResource PageTitleStyle}"/><TextBlock Text="扫描只生成候选。请核对后选择导入，不会执行或修改游戏文件。" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/></StackPanel>
  <Border Grid.Row="1" Style="{StaticResource ToolbarSurfaceStyle}" Padding="16"><VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="184" ItemHeight="44" MaximumRowsOrColumns="3"><Button Content="选择目录并扫描" Click="OnChoose" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="ChooseScanRoot"/><Button Content="取消扫描" Click="OnCancel" IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}" AutomationProperties.AutomationId="CancelScan"/><Button Content="全选可导入候选" Click="OnSelectAll" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}"/></VariableSizedWrapGrid></Border>
  <StackPanel Grid.Row="2" Spacing="12"><TextBlock Text="{x:Bind ViewModel.ScanMessage, Mode=OneWay}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" AutomationProperties.AutomationId="ScanState" AutomationProperties.LiveSetting="Polite"/><Button Content="重新检查当前目录" Click="OnRetry" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="RetryScan"/><ProgressBar IsIndeterminate="True" Visibility="{x:Bind Visible(ViewModel.IsScanning), Mode=OneWay}" AutomationProperties.Name="正在扫描本地游戏目录"/></StackPanel>
  <Border Grid.Row="3" Style="{StaticResource SurfaceStyle}" Padding="12">
   <ListView x:Name="CandidateList" ItemsSource="{x:Bind ViewModel.Candidates, Mode=OneWay}" SelectionMode="Multiple" AutomationProperties.AutomationId="ScanCandidates" AutomationProperties.Name="待导入的本地游戏候选"><ListView.ItemTemplate><DataTemplate x:DataType="app:ScanCandidate"><StackPanel Padding="12" Spacing="8"><TextBlock Text="{x:Bind Name}" Style="{StaticResource CardTitleStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Folder.StoredPath}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Evidence}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{x:Bind Preflight.Path.Message}" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListView.ItemTemplate></ListView>
  </Border>
  <Border Grid.Row="4" Style="{StaticResource ToolbarSurfaceStyle}" Padding="16,12"><Button Content="导入所选候选" Click="OnImport" IsEnabled="{x:Bind Workspace.CanEdit, Mode=OneWay}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" AutomationProperties.AutomationId="ImportSelected"/></Border>
 </Grid>
</Page>
