<ContentDialog x:Class="TheOrder.WinUI.Views.CoverSelectionDialog"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:TheOrder.WinUI.Views" Title="选择作品封面" PrimaryButtonText="使用此封面" CloseButtonText="取消" DefaultButton="Close" IsPrimaryButtonEnabled="False">
 <StackPanel Spacing="12">
  <TextBlock Text="资料源默认封面不按票数自动替换。个人选择会随同一作品的资料刷新保留；保存后替换原本地封面。" TextWrapping="Wrap"/>
  <ListView x:Name="CoverList" MaxHeight="380" MinWidth="280" SelectionMode="Single" SelectionChanged="OnSelection"
    AutomationProperties.AutomationId="WorkCoverOptions" AutomationProperties.Name="作品封面与资料源默认选项">
   <ListView.ItemTemplate><DataTemplate x:DataType="local:CoverOption">
    <Grid Padding="4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="104" Height="132" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
      <local:CoverPresenter SourceKey="{x:Bind ImageKey}" MinimumEdge="192" PreserveEntireImage="True"/>
     </Border>
     <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap"/>
      <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
     </StackPanel>
    </Grid>
   </DataTemplate></ListView.ItemTemplate>
  </ListView>
 </StackPanel>
</ContentDialog>
