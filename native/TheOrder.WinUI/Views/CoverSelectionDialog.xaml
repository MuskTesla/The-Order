<?xml version="1.0" encoding="utf-8"?><ContentDialog x:Class="TheOrder.WinUI.Views.CoverSelectionDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:TheOrder.WinUI.Views" DefaultButton="Close" IsPrimaryButtonEnabled="False" l:Localize.Title="选择作品封面" l:Localize.PrimaryButtonText="使用此封面" l:Localize.CloseButtonText="取消" xmlns:l="using:TheOrder.WinUI.Localization">
 <StackPanel Spacing="12">
  <TextBlock TextWrapping="Wrap" l:Localize.Text="自动推荐优先保留构图，并兼顾清晰度。手动选定的封面会随同一作品的资料刷新保留；保存后替换原本地封面。" />
  <ListView x:Name="CoverList" MaxHeight="380" MinWidth="280" SelectionMode="Single" SelectionChanged="OnSelection" AutomationProperties.AutomationId="WorkCoverOptions" l:Localize.Name="作品封面与自动推荐选项">
   <ListView.ItemTemplate><DataTemplate x:DataType="local:CoverOption">
    <Grid Padding="4" ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <Border Width="104" Height="132" Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4">
      <local:CoverPresenter SourceKey="{x:Bind ImageKey}" MinimumEdge="192" PreserveEntireImage="True" ImageCornerRadius="4" />
     </Border>
     <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
      <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
     </StackPanel>
    </Grid>
   </DataTemplate></ListView.ItemTemplate>
  </ListView>
 </StackPanel>
</ContentDialog>
