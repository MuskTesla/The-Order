<?xml version="1.0" encoding="utf-8"?><Page x:Class="TheOrder.WinUI.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:app="using:TheOrder.Application" xmlns:views="using:TheOrder.WinUI.Views" xmlns:l="using:TheOrder.WinUI.Localization">
 <Page.Resources>
  <Style x:Key="CardContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}"><Setter Property="Margin" Value="0" /><Setter Property="Padding" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="VerticalContentAlignment" Value="Stretch" /></Style>
  <Style x:Key="CollectionRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="56" /><Setter Property="Padding" Value="12,0,12,0" /></Style>
  <!-- One shared context menu; items are rebuilt for the target card and the current mode. -->
  <MenuFlyout x:Key="CardMenu" Opening="OnCardMenuOpening" />
  <DataTemplate x:Key="CardTemplate" x:DataType="app:GameSummary">
   <Border Margin="8,8,8,16" Padding="0" Background="Transparent" ContextFlyout="{StaticResource CardMenu}" AutomationProperties.Name="{x:Bind views:LibraryFormat.CardName(Name, StatusText, LastPlayedText)}">
    <Grid RowSpacing="9"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="48" /></Grid.RowDefinitions>
     <Border CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><Grid><FontIcon Glyph="" FontSize="24" Foreground="{ThemeResource TextTertiaryBrush}" AutomationProperties.AccessibilityView="Raw" /><views:CoverPresenter SourceKey="{x:Bind CoverKey}" /></Grid></Border>
      <TextBlock Grid.Row="1" Text="{x:Bind Name}" TextAlignment="Center" HorizontalAlignment="Stretch" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" MaxLines="2" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name}" />
    </Grid>
   </Border>
  </DataTemplate>
  <DataTemplate x:Key="RowTemplate" x:DataType="app:GameSummary">
   <Grid MinHeight="70" ColumnSpacing="16" Background="Transparent" ContextFlyout="{StaticResource CardMenu}" AutomationProperties.Name="{x:Bind views:LibraryFormat.CardName(Name, StatusText, LastPlayedText)}">
    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Border Width="42" Height="56" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center"><views:CoverPresenter SourceKey="{x:Bind CoverKey}" ImageCornerRadius="4" /></Border>
    <TextBlock Grid.Column="1" Text="{x:Bind Name}" FontSize="15" Foreground="{ThemeResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}" />
   </Grid>
  </DataTemplate>
 </Page.Resources>
 <Grid x:Name="LibraryCanvas" SizeChanged="OnLibrarySizeChanged" KeyDown="OnPageKeyDown">
  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <!-- Header: title + count, then sort · filter · view · select · import (labels collapse below 900). -->
  <Grid x:Name="HeaderRow" Padding="32,16,24,8" ColumnSpacing="16"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <StackPanel x:Name="HeaderIdentity" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
    <TextBlock Style="{StaticResource TitleTextBlockStyle}" l:Localize.Text="书架" />
    <TextBlock x:Name="CountText" Text="{x:Bind ViewModel.CountText, Mode=OneWay}" Style="{StaticResource MetadataTextStyle}" VerticalAlignment="Bottom" Margin="0,0,0,6" AutomationProperties.AutomationId="LibraryStatus" />
   </StackPanel>
   <StackPanel x:Name="HeaderCommands" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
     <Button x:Name="SearchButton" AutomationProperties.AutomationId="OpenLibrarySearch" l:Localize.Name="搜索书架" l:Localize.ToolTip="搜索书架（Ctrl+F）">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock x:Name="SearchLabel" l:Localize.Text="搜索" /></StackPanel>
      <Button.Flyout><Flyout x:Name="SearchFlyout" Placement="BottomEdgeAlignedRight" Opened="OnSearchOpened"><AutoSuggestBox x:Name="LibrarySearch" Width="300" QueryIcon="Find" TextChanged="OnSearchChanged" QuerySubmitted="OnSearchSubmitted" AutomationProperties.AutomationId="LibrarySearch" l:Localize.PlaceholderText="搜索书架" l:Localize.Name="搜索书架，支持名称、原名、标签、开发商及安装目录" /></Flyout></Button.Flyout>
     </Button>
    <DropDownButton x:Name="SortButton" AutomationProperties.AutomationId="LibrarySort" l:Localize.Name="作品排序">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock x:Name="SortLabel" l:Localize.Text="最近添加" /></StackPanel>
     <DropDownButton.Flyout>
      <MenuFlyout x:Name="SortMenu" Placement="BottomEdgeAlignedRight">
       <RadioMenuFlyoutItem Tag="added" GroupName="Sort" Click="OnSortItem" l:Localize.Text="最近添加" /><RadioMenuFlyoutItem Tag="recent" GroupName="Sort" Click="OnSortItem" l:Localize.Text="最近游玩" />
       <RadioMenuFlyoutItem Tag="name" GroupName="Sort" Click="OnSortItem" l:Localize.Text="名称" /><RadioMenuFlyoutItem Tag="rating" GroupName="Sort" Click="OnSortItem" l:Localize.Text="我的评分" />
       <RadioMenuFlyoutItem Tag="playtime" GroupName="Sort" Click="OnSortItem" l:Localize.Text="游玩时长" />
      </MenuFlyout>
     </DropDownButton.Flyout>
    </DropDownButton>
    <Button x:Name="FilterButton" AutomationProperties.AutomationId="LibraryFilters" l:Localize.Name="展开作品筛选">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock x:Name="FilterLabel" l:Localize.Text="筛选" /><InfoBadge x:Name="FilterBadge" Visibility="Collapsed" Value="0" Style="{ThemeResource AttentionValueInfoBadgeStyle}" /></StackPanel>
     <Button.Flyout><Flyout x:Name="FilterFlyout" Placement="BottomEdgeAlignedRight" Opening="OnFilterOpening">
      <Grid x:Name="FilterPanel" Width="300" Height="520" MaxHeight="520" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
       <ScrollViewer x:Name="FilterBody" AutomationProperties.AutomationId="FilterBody" VerticalScrollBarVisibility="Auto"><StackPanel Spacing="12" Padding="0,0,12,0">
        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" l:Localize.Text="筛选作品" />
        <ComboBox x:Name="ViewChoice" HorizontalAlignment="Stretch" SelectionChanged="OnFilter" AutomationProperties.AutomationId="LibraryView" l:Localize.Header="作品范围" l:Localize.Name="作品范围"><ComboBoxItem Tag="all" l:Localize.Content="全部作品" /><ComboBoxItem Tag="local" l:Localize.Content="本地游戏" /><ComboBoxItem Tag="wishlist" l:Localize.Content="愿望单" /><ComboBoxItem Tag="unmatched" l:Localize.Content="缺资料" /><ComboBoxItem Tag="unconfigured" l:Localize.Content="待设启动程序" /></ComboBox>
        <ComboBox x:Name="StatusChoice" HorizontalAlignment="Stretch" SelectionChanged="OnFilter" AutomationProperties.AutomationId="StatusFilter" l:Localize.Header="游玩状态" l:Localize.Name="按游玩状态筛选"><ComboBoxItem Tag="all" l:Localize.Content="全部状态" /><ComboBoxItem Tag="planned" l:Localize.Content="未开始" /><ComboBoxItem Tag="playing" l:Localize.Content="在玩" /><ComboBoxItem Tag="completed" l:Localize.Content="已完成" /><ComboBoxItem Tag="paused" l:Localize.Content="搁置" /><ComboBoxItem Tag="dropped" l:Localize.Content="放弃" /></ComboBox>
        <TextBox x:Name="CategoryFilter" TextChanged="OnFilterText" AutomationProperties.AutomationId="CategoryFilter" l:Localize.Header="分类" l:Localize.PlaceholderText="输入完整分类名称" l:Localize.Name="按完整分类名称筛选" />
        <TextBox x:Name="TagFilter" TextChanged="OnFilterText" AutomationProperties.AutomationId="TagFilter" l:Localize.Header="个人标签" l:Localize.PlaceholderText="输入完整标签名称" l:Localize.Name="按完整个人标签筛选" />
        <ComboBox x:Name="MinimumChoice" HorizontalAlignment="Stretch" SelectionChanged="OnFilter" AutomationProperties.AutomationId="RatingFilter" l:Localize.Header="个人评分" l:Localize.Name="按个人评分筛选"><ComboBoxItem Tag="" l:Localize.Content="全部评分" /><ComboBoxItem Tag="0" l:Localize.Content="已评分" /><ComboBoxItem Tag="6" l:Localize.Content="评分 ≥ 6" /><ComboBoxItem Tag="8" l:Localize.Content="评分 ≥ 8" /></ComboBox>
        <CheckBox x:Name="FavoriteFilter" Checked="OnFavoriteFilter" Unchecked="OnFavoriteFilter" AutomationProperties.AutomationId="FavoriteFilter" l:Localize.Content="只看收藏" />
        <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="0,4" />
        <ComboBox x:Name="SavedChoice" HorizontalAlignment="Stretch" ItemsSource="{x:Bind ViewModel.SavedFilters, Mode=OneWay}" DisplayMemberPath="Name" SelectionChanged="OnSavedFilter" AutomationProperties.AutomationId="SavedFilters" l:Localize.Header="常用筛选" l:Localize.PlaceholderText="选择保存的筛选" l:Localize.Name="应用常用筛选" />
       </StackPanel></ScrollViewer>
       <StackPanel x:Name="FilterFooter" Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Style="{StaticResource AccentButtonStyle}" Click="OnFinishFilter" AutomationProperties.AutomationId="FinishFilter" l:Localize.Content="完成" l:Localize.Name="完成筛选，条件已即时应用" /><Button Click="OnSaveFilter" IsEnabled="{x:Bind ViewModel.CanManageFilters, Mode=OneWay}" l:Localize.Content="保存筛选" l:Localize.Name="保存当前筛选条件" /><Button Click="OnClear" l:Localize.Content="清除条件" l:Localize.Name="清除全部筛选条件" /></StackPanel>
      </Grid>
     </Flyout></Button.Flyout>
    </Button>
    <StackPanel Orientation="Horizontal" Spacing="2">
     <ToggleButton x:Name="GridModeButton" Width="40" Click="OnGrid" AutomationProperties.AutomationId="GridMode" l:Localize.Name="网格视图" l:Localize.ToolTip="网格视图"><FontIcon Glyph="" FontSize="14" /></ToggleButton>
     <ToggleButton x:Name="ListModeButton" Width="40" Click="OnList" AutomationProperties.AutomationId="ListMode" l:Localize.Name="列表视图" l:Localize.ToolTip="列表视图"><FontIcon Glyph="" FontSize="14" /></ToggleButton>
    </StackPanel>
    <ToggleButton x:Name="SelectButton" Click="OnSelectToggle" AutomationProperties.AutomationId="SelectionMode" l:Localize.Name="选择作品" l:Localize.ToolTip="选择作品（Ctrl+单击）">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock x:Name="SelectLabel" l:Localize.Text="选择" /></StackPanel>
    </ToggleButton>
    <Button x:Name="ImportButton" Click="OnImport" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" AutomationProperties.AutomationId="OpenImport" l:Localize.Name="导入本地游戏目录">
     <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock x:Name="ImportLabel" l:Localize.Text="导入" /></StackPanel>
    </Button>
    <Button x:Name="PendingReviewButton" Visibility="Collapsed" Click="OnPendingReview" AutomationProperties.AutomationId="OpenPendingReview" l:Localize.Content="待核对" />
    <Button x:Name="LibraryMore" Width="40" Style="{StaticResource SubtleButtonStyle}" AutomationProperties.AutomationId="LibraryMore" l:Localize.Name="更多书架操作"><FontIcon Glyph="" FontSize="14" />
     <Button.Flyout><MenuFlyout Placement="BottomEdgeAlignedRight"><MenuFlyoutItem x:Name="MoreSelect" Click="OnMoreSelect" Visibility="Collapsed" l:Localize.Text="选择作品"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem x:Name="MoreImport" Click="OnImport" Visibility="Collapsed" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" l:Localize.Text="导入目录"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem><MenuFlyoutItem Click="OnReload" IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}" AutomationProperties.AutomationId="ReloadLibrary" l:Localize.Text="重新读取书架"><MenuFlyoutItem.Icon><FontIcon Glyph="" /></MenuFlyoutItem.Icon></MenuFlyoutItem></MenuFlyout></Button.Flyout>
    </Button>
   </StackPanel>
  </Grid>
  <!-- Active conditions: one chip each (× removes it) + 清除全部. Present only while filters are active. -->
  <Grid x:Name="ActiveFilterRegion" Grid.Row="1" Visibility="Collapsed" Padding="32,0,24,8" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <ScrollViewer HorizontalScrollBarVisibility="Hidden" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
    <StackPanel x:Name="FilterChips" Orientation="Horizontal" Spacing="8" AutomationProperties.AutomationId="ActiveFilterSummary" l:Localize.Name="当前筛选条件" />
   </ScrollViewer>
   <HyperlinkButton Grid.Column="1" Click="OnClear" l:Localize.Content="清除全部" l:Localize.Name="清除全部筛选条件" />
  </Grid>
  <!-- Selection mode bar (replaces the header actions while selecting). -->
  <Grid x:Name="SelectionContext" Grid.Row="2" Visibility="Collapsed" Margin="24,0,24,8" Padding="12,6" ColumnSpacing="8" CornerRadius="8" Background="{ThemeResource ContentBrush}" BorderBrush="{ThemeResource StrokeBrush}" BorderThickness="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
   <TextBlock x:Name="SelectionCountText" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" AutomationProperties.AutomationId="LibrarySelectionCount" AutomationProperties.LiveSetting="Polite" l:Localize.Text="已选择 0 项" />
   <StackPanel x:Name="ContextActions" Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="12,0,0,0">
    <Button x:Name="SelectAllButton" Style="{StaticResource SubtleButtonStyle}" Click="OnSelectAll" AutomationProperties.AutomationId="SelectAll"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock l:Localize.Text="全选" /></StackPanel></Button>
    <Button x:Name="RecognizeSelectedButton" Style="{StaticResource SubtleButtonStyle}" Click="OnRecognize" IsEnabled="False" AutomationProperties.AutomationId="RecognizeSelected" l:Localize.Name="识别所选作品"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock l:Localize.Text="识别所选" /></StackPanel></Button>
    <Button x:Name="BatchEditButton" Style="{StaticResource SubtleButtonStyle}" Click="OnBatch" IsEnabled="False" AutomationProperties.AutomationId="BatchEdit" l:Localize.Name="批量编辑所选作品"><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="" FontSize="14" /><TextBlock l:Localize.Text="批量编辑" /></StackPanel></Button>
    <TextBlock x:Name="SelectionHint" Style="{StaticResource MetadataTextStyle}" VerticalAlignment="Center" Margin="8,0,0,0" l:Localize.Text="Shift+单击选择范围 · Esc 退出" />
   </StackPanel>
   <Button Grid.Column="2" Click="OnSelectionDone" AutomationProperties.AutomationId="SelectionDone" l:Localize.Content="完成" l:Localize.Name="完成选择" />
  </Grid>
  <Grid x:Name="BooksViewport" Grid.Row="3">
   <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
   <ProgressBar Grid.RowSpan="2" IsIndeterminate="True" Height="2" VerticalAlignment="Top" Canvas.ZIndex="1" Visibility="{x:Bind Visible(ViewModel.IsSearching), Mode=OneWay}" l:Localize.Name="正在更新书架" />
    <!-- Sticky name header matches the poster/name rows. Other sort keys remain in the sort menu. -->
    <Grid x:Name="ListHeader" Height="36" Margin="24,0,24,0" Padding="12,0,28,0" ColumnSpacing="16" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,0,0,1" Visibility="Collapsed">
     <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
     <HyperlinkButton Grid.Column="1" Tag="name" Click="OnHeaderSort" Padding="0" Foreground="{ThemeResource TextSecondaryBrush}" l:Localize.Name="按名称排序"><TextBlock x:Name="HeaderName" Style="{StaticResource CaptionTextBlockStyle}" l:Localize.Text="名称" /></HyperlinkButton>
   </Grid>
   <!-- Bounded viewport; ItemsWrapGrid / ItemsStackPanel stay virtualized; the inactive source remains null. -->
   <GridView x:Name="GameGrid" Grid.Row="1" Padding="18,0,18,24" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick" ItemTemplate="{StaticResource CardTemplate}" ItemContainerStyle="{StaticResource CardContainerStyle}" PreviewKeyDown="OnItemsPreviewKey" SelectionChanged="OnItemSelectionChanged" ContainerContentChanging="OnContainerChanging" SizeChanged="OnGridSizeChanged" AutomationProperties.AutomationId="LibraryGrid" l:Localize.Name="游戏网格">
    <GridView.ItemsPanel><ItemsPanelTemplate><ItemsWrapGrid Orientation="Horizontal" Loaded="OnWrapGridLoaded" /></ItemsPanelTemplate></GridView.ItemsPanel>
   </GridView>
   <ListView x:Name="GameList" Grid.Row="1" Visibility="Collapsed" Padding="24,0,24,24" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnItemClick" ItemTemplate="{StaticResource RowTemplate}" ItemContainerStyle="{StaticResource CollectionRowStyle}" PreviewKeyDown="OnItemsPreviewKey" SelectionChanged="OnItemSelectionChanged" ContainerContentChanging="OnContainerChanging" AutomationProperties.AutomationId="LibraryList" l:Localize.Name="游戏列表" />
   <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Spacing="12" Visibility="{x:Bind Visible(ViewModel.IsEmpty), Mode=OneWay}" AutomationProperties.AutomationId="LibraryEmpty">
    <FontIcon Glyph="" FontSize="32" Foreground="{ThemeResource TextTertiaryBrush}" />
    <TextBlock Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" />
    <Button x:Name="EmptyImport" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center" Click="OnImport" IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}" l:Localize.Content="导入目录" />
    <Button x:Name="EmptyClear" HorizontalAlignment="Center" Click="OnClear" l:Localize.Content="清除筛选" />
   </StackPanel>
   <ProgressRing Grid.Row="1" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" HorizontalAlignment="Center" VerticalAlignment="Center" l:Localize.Name="正在加载书架" />
  </Grid>
  <TextBlock Grid.Row="4" x:Name="DiagnosticsText" Visibility="Collapsed" FontSize="11" Margin="24,0" AutomationProperties.AutomationId="VirtualizationProbe" />
 </Grid>
</Page>
