<Page x:Class="TheOrder.WinUI.Views.LibraryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:domain="using:TheOrder.Domain">
  <Grid Padding="28" RowSpacing="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <StackPanel Spacing="6"><TextBlock Text="书架" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock Text="Phase 1 · 合成资料只读预览" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="{x:Bind ViewModel.Status, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="LibraryStatus" />
      <Button Grid.Column="1" Content="重新读取" Click="OnReload" IsEnabled="{x:Bind ViewModel.CanReload, Mode=OneWay}" AutomationProperties.AutomationId="ReloadLibrary" />
    </Grid>
    <!-- Bounded viewport and default ItemsStackPanel preserve ListView UI virtualization. -->
    <ListView Grid.Row="2" ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}" SelectionMode="None" AutomationProperties.Name="合成游戏书架" AutomationProperties.AutomationId="LibraryList">
      <ListView.ItemTemplate><DataTemplate x:DataType="domain:LibrarySummary">
        <Grid Padding="8" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Border Width="48" Height="64" CornerRadius="4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"><FontIcon Glyph="&#xE8F1;" FontSize="22" /></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{x:Bind Name}" FontSize="17" TextTrimming="CharacterEllipsis" /><TextBlock Text="{x:Bind Subtitle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
        </Grid>
      </DataTemplate></ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
